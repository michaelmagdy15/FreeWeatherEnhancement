    {
      "name": "Debug SkyWeave.Api (REST Server)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/SkyWeave.Api/bin/Debug/net8.0/SkyWeave.Api.dll",
      "args": [],

<Application x:Class="SkyWeave.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:SkyWeave.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <local:BoolToBrushConverter x:Key="BoolToBrush"/>
            <local:ThresholdToBrushConverter x:Key="ThresholdToBrush"/>
            <local:FlightCategoryToBrushConverter x:Key="FlightCategoryToBrush"/>
            <local:FlightCategoryToChipBrushConverter x:Key="FlightCategoryToChipBrush"/>
            <local:IndexToProgressConverter x:Key="IndexToProgress"/>
            <local:IndexToProgressValueConverter x:Key="IndexToProgressValue"/>
            <local:BoolToOpacityConverter x:Key="BoolToOpacity"/>
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>

            <!-- Dark Flight Deck Color Tokens -->
            <SolidColorBrush x:Key="Bg.Deep" Color="#030712"/>
            <SolidColorBrush x:Key="Bg.Panel" Color="#CC0F172A"/>
            <SolidColorBrush x:Key="Bg.Panel.Hover" Color="#E61E293B"/>
            <SolidColorBrush x:Key="Bg.Inset" Color="#0B1120"/>
            
            <SolidColorBrush x:Key="Stroke.Subtle" Color="#334155"/>
            <SolidColorBrush x:Key="Stroke.Focus" Color="#38BDF8"/>
            <SolidColorBrush x:Key="Accent.Brand" Color="#E81CFF"/>
            <SolidColorBrush x:Key="Accent.Brand.Glow" Color="#66E81CFF"/>
            <SolidColorBrush x:Key="Accent.Teal" Color="#00F0FF"/>
            <SolidColorBrush x:Key="Accent.Orange" Color="#F97316"/>
            
            <SolidColorBrush x:Key="Data.Good" Color="#00F0FF"/>
            <SolidColorBrush x:Key="Data.Caution" Color="#F59E0B"/>
            <SolidColorBrush x:Key="Data.Warning" Color="#F97316"/>
            <SolidColorBrush x:Key="Data.Critical" Color="#EF4444"/>
            <SolidColorBrush x:Key="Data.Info" Color="#3B82F6"/>
            <SolidColorBrush x:Key="Data.Ice" Color="#00F0FF"/>
            
            <SolidColorBrush x:Key="Text.Primary" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="Text.Secondary" Color="#94A3B8"/>
            <SolidColorBrush x:Key="Text.Disabled" Color="#475569"/>

            <!-- Tactical Cockpit Panel Style -->
            <Style x:Key="TacticalPanel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Bg.Panel}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Stroke.Subtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="14"/>
            </Style>

            <Style x:Key="InsetWell" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Bg.Inset}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Stroke.Subtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>

            <Style x:Key="SeverityChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="HeaderLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource Accent.Brand}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="SubHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource Accent.Brand}"/>
            </Style>

            <Style x:Key="DataLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="DataValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

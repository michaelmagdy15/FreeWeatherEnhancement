<ui:FluentWindow x:Class="SkyWeave.App.Views.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:vm="clr-namespace:SkyWeave.App.ViewModels"
                  xmlns:local="clr-namespace:SkyWeave.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  mc:Ignorable="d"
                  Title="SkyWeave - Real Weather Engine for MSFS 2024"
                  Width="1400" Height="920"
                  MinWidth="1200" MinHeight="720"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="Mica"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="Auto"/> <!-- Header Controls -->
            <RowDefinition Height="*"/>    <!-- Content Grid -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Native Windows 11 TitleBar with Snap Layouts support -->
        <ui:TitleBar Grid.Row="0"
                     Title="SkyWeave">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/SkyWeave.ico"/>
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Background="{StaticResource Accent.Brand}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionText}" FontSize="10" Foreground="{StaticResource Text.Primary}" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Real Weather Engine for MSFS 2024" FontSize="11" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Tactical Glass Header -->
        <Border Grid.Row="1" Background="#800F172A" BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="8,3" CornerRadius="6" Background="#26E81CFF" BorderBrush="{StaticResource Accent.Brand}" BorderThickness="1">
                        <TextBlock Text="SKYWEAVE" FontSize="18" FontWeight="Black" Foreground="{StaticResource Accent.Brand}" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="COCKPIT WEATHER MANAGEMENT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Connection Telemetry & Zulu Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Background="#1A00F0FF" BorderBrush="#3300F0FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ZULU " FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ZuluTimeText}" FontSize="11" FontFamily="Consolas, Courier New" FontWeight="Bold" Foreground="{StaticResource Accent.Teal}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2638BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Connection.SkyAnchorPhaseBadge}" FontSize="9" FontWeight="Black" Foreground="#38BDF8"/>
                    </Border>
                    <!-- Online Network ATC Badge -->
                    <Border Visibility="{Binding IsOnlineNetworkActive, Converter={StaticResource BooleanToVisibility}}"
                            Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center"
                            ToolTip="Online ATC / AI network client detected (METAR ground truth preserved)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OnlineNetworkName}" FontSize="9" FontWeight="Black" Foreground="#10B981" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Historical Weather Replay Badge -->
                    <Border Visibility="{Binding IsHistoricalMode, Converter={StaticResource BooleanToVisibility}}"
                            Background="#26F59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center"
                            ToolTip="ERA5 Historical Reanalysis Replay Active">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏳ " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Text="HISTORICAL REPLAY" FontSize="9" FontWeight="Black" Foreground="#F59E0B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Sandbox Mode Badge -->
                    <Border Visibility="{Binding IsSandboxMode, Converter={StaticResource BooleanToVisibility}}"
                            Background="#268B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center"
                            ToolTip="Sandbox Custom Weather Scenario Active">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛠️ " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Text="SANDBOX STUDIO" FontSize="9" FontWeight="Black" Foreground="#A78BFA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Traffic Count Badge -->
                    <Border Visibility="{Binding Connection.IsConnected, Converter={StaticResource BooleanToVisibility}}"
                            Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="{Binding TrafficStatusText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✈️ " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TrafficCount, StringFormat={}{0} TRAFFIC}" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Wake Turbulence Alert Badge -->
                    <Border Visibility="{Binding HasWakeEncounter, Converter={StaticResource BooleanToVisibility}}"
                            Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center"
                            ToolTip="{Binding WakeStatusText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Text="WAKE ALERT" FontSize="9" FontWeight="Black" Foreground="#EF4444" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Connection.LastUpdate}" Foreground="{StaticResource Text.Secondary}" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <Ellipse Width="10" Height="10" Fill="{Binding Connection.IsConnected, Converter={StaticResource BoolToBrush}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Connection.StatusText}" Foreground="{StaticResource Text.Primary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Command Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Connect"
                               Command="{Binding Connection.ConnectCommand}"
                               IsEnabled="{Binding Connection.IsConnected, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Inverse}"
                               Margin="0,0,6,0" Padding="12,6"/>
                    <Primitives:ToggleButton xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                                             Content="Start Injecting"
                                             Command="{Binding Connection.StartWeatherCommand}"
                                             IsChecked="{Binding Connection.IsInjecting, Mode=OneWay}"
                                             FontWeight="Bold"
                                             Margin="0,0,6,0" Padding="12,6"/>
                    <Primitives:ToggleButton xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                                             Content="FREEZE"
                                             Command="{Binding Connection.ToggleFreezeCommand}"
                                             IsChecked="{Binding Connection.IsFrozen, Mode=OneWay}"
                                             FontWeight="Black"
                                             Foreground="{StaticResource Data.Caution}"
                                             Margin="0,0,6,0" Padding="12,6"/>
                    <Primitives:ToggleButton xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                                             Content="Passive"
                                             Command="{Binding Connection.StartPassiveCommand}"
                                             IsChecked="{Binding Connection.IsPassiveMode, Mode=OneWay}"
                                             Margin="0,0,6,0" Padding="12,6"/>
                    <ui:Button Content="Refresh"
                               Command="{Binding Connection.RefreshNowCommand}"
                               Margin="0,0,6,0" Padding="12,6"/>
                    <ui:Button Content="Stop"
                               Command="{Binding Connection.StopWeatherCommand}"
                               Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Cockpit Dashboard Grid -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Row 0, Col 0: Current Conditions & TAF Brief -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TacticalPanel}" Margin="0,0,5,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CURRENT CONDITIONS" Style="{StaticResource HeaderLabel}"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Station:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.StationId}" Style="{StaticResource DataValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Temperature:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Temperature}" Style="{StaticResource DataValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dewpoint:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Dewpoint}" Foreground="{StaticResource Accent.Teal}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Wind:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Wind}" Style="{StaticResource DataValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Visibility:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Visibility}" Style="{StaticResource DataValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Altimeter:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Altimeter}" Style="{StaticResource DataValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,4" Visibility="{Binding Connection.HasSimWeatherReadback, Converter={StaticResource BooleanToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sim Readback:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Connection.SimWeatherInfo}" Foreground="{StaticResource Accent.Teal}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Live ATIS Broadcast Row -->
                        <Grid Margin="0,0,0,4" Visibility="{Binding WeatherDisplay.HasAtis, Converter={StaticResource BooleanToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Live ATIS:" Style="{StaticResource DataLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#2600D2D3" BorderBrush="#00D2D3" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding WeatherDisplay.AtisBadgeText}" Foreground="#00D2D3" FontWeight="Bold" FontSize="10"/>
                                </Border>
                                <TextBlock Text="{Binding WeatherDisplay.AtisSummaryText}" ToolTip="{Binding WeatherDisplay.AtisRawText}" Style="{StaticResource DataValue}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Category:" Style="{StaticResource DataLabel}"/>
                            <Border Grid.Column="1" Background="{Binding WeatherDisplay.FlightCategory, Converter={StaticResource FlightCategoryToBrush}}"
                                    CornerRadius="3" Padding="6,1" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding WeatherDisplay.FlightCategory}" FontWeight="Bold" FontSize="10" Foreground="White"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Humidity:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Humidity}" Style="{StaticResource DataValue}"/>
                        </Grid>

                        <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,4,0,8"/>

                        <!-- TAF Section -->
                        <TextBlock Text="TAF BRIEF" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource InsetWell}" Padding="8,6" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Taf.TafText}" FontFamily="Consolas, Courier New" FontSize="10" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap" MaxHeight="44"/>
                        </Border>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Forecast Cat:" Style="{StaticResource DataLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Style="{StaticResource SeverityChip}" Background="{Binding Taf.TafFlightCategory, Converter={StaticResource FlightCategoryToChipBrush}}">
                                    <TextBlock Text="{Binding Taf.TafFlightCategory}" FontSize="10" FontWeight="Bold" Foreground="{Binding Taf.TafFlightCategory, Converter={StaticResource FlightCategoryToBrush}}"/>
                                </Border>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Data.Caution}" VerticalAlignment="Center" Margin="6,0,0,0"
                                         Visibility="{Binding Taf.TafDivergence, Converter={StaticResource BooleanToVisibility}}" ToolTip="METAR and TAF flight categories diverge"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Validity:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Taf.TafValidity}" FontSize="10" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Wind:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Taf.TafWind}" FontSize="10" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Visibility:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Taf.TafVisibility}" FontSize="10" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="FORECAST TREND" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,4"/>
                        <ItemsControl ItemsSource="{Binding Taf.TafGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" BorderThickness="1" Margin="0,0,4,0"
                                            BorderBrush="{Binding FlightCategory, Converter={StaticResource FlightCategoryToBrush}}"
                                            Background="{Binding FlightCategory, Converter={StaticResource FlightCategoryToChipBrush}}"
                                            Opacity="{Binding BlockOpacity}"
                                            Width="72" Height="40" Padding="4,2">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding FlightCategory, Converter={StaticResource FlightCategoryToBrush}}"/>
                                            <TextBlock Text="{Binding CloudSummary}" FontSize="8" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Wind}" FontSize="8" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Row 0, Col 1: Weather Indices -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TacticalPanel}" Margin="5,0,5,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="WEATHER INDICES" Style="{StaticResource HeaderLabel}"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Freezing Level:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.FreezingLevel}" Style="{StaticResource DataValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Ceiling:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Ceiling}" Style="{StaticResource DataValue}"/>
                        </Grid>

                        <!-- Icing Index -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Icing Index:" Style="{StaticResource DataLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="{Binding WeatherDisplay.IcingIndex}" FontWeight="Bold" FontSize="11" Foreground="#FF6B6B"/>
                                <ProgressBar Height="4" Value="{Binding WeatherDisplay.IcingIndex, Converter={StaticResource IndexToProgressValue}}" Maximum="100" Margin="0,3,0,0" Foreground="#FF6B6B"/>
                            </StackPanel>
                        </Grid>

                        <!-- Turbulence Index -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Turbulence:" Style="{StaticResource DataLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="{Binding WeatherDisplay.TurbulenceIndex}" FontWeight="Bold" FontSize="11" Foreground="#FFA502"/>
                                <ProgressBar Height="4" Value="{Binding WeatherDisplay.TurbulenceIndex, Converter={StaticResource IndexToProgressValue}}" Maximum="100" Margin="0,3,0,0" Foreground="#FFA502"/>
                            </StackPanel>
                        </Grid>

                        <!-- Thunderstorm Intensity -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Thunderstorm:" Style="{StaticResource DataLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="{Binding WeatherDisplay.ThunderstormIntensity}" FontWeight="Bold" FontSize="11" Foreground="#FF4757"/>
                                <ProgressBar Height="4" Value="{Binding WeatherDisplay.ThunderstormIntensity, Converter={StaticResource IndexToProgressValue}}" Maximum="100" Margin="0,3,0,0" Foreground="#FF4757"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Precipitation:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Precipitation}" Style="{StaticResource DataValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Aerosol Density:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.AerosolDensity}" Style="{StaticResource DataValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Source Model:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.SourceModel}" Foreground="{StaticResource Accent.Teal}" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Data Age:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.DataAge}" Style="{StaticResource DataValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CAPE (J/kg):" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.CapeValue}" Foreground="#FFD700" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Lifted Index:" Style="{StaticResource DataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.LiftedIndexValue}" Foreground="#FFA502" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Row 0, Col 2: SimBrief Flight Plan Corridor & Storms -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TacticalPanel}" Margin="5,0,5,5">
                <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                    <!-- Tab 1: SimBrief & FMC Corridor -->
                    <TabItem Header="✈ SIMBRIEF &amp; NAVIGRAPH" FontSize="11" FontWeight="Bold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding FlightPlan.PilotId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Padding="8,4" Margin="0,0,6,0"/>
                                    <ui:Button Grid.Column="1" Content="Fetch OFP" Command="{Binding FlightPlan.FetchPlanCommand}"
                                               FontWeight="Bold" Padding="10,4"/>
                                </Grid>
                                <TextBlock Text="{Binding FlightPlan.StatusMessage}" FontSize="10" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                                <!-- Navigraph AIRAC & Actions Bar -->
                                <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,6"
                                        Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🌐 " FontSize="10"/>
                                            <TextBlock Text="{Binding FlightPlan.NavigraphAirac}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="📋 Copy Route" Command="{Binding FlightPlan.CopyRouteCommand}" FontSize="9" Padding="6,2" Margin="4,0,4,0"/>
                                        <ui:Button Grid.Column="2" Content="🗺 Charts" Command="{Binding FlightPlan.OpenNavigraphChartsCommand}" FontSize="9" Padding="6,2"/>
                                    </Grid>
                                </Border>

                                <!-- Flight Summary -->
                                <Grid Margin="0,0,0,6" Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="FLIGHT: " FontSize="10" Foreground="{StaticResource Text.Disabled}"/>
                                        <TextBlock Text="{Binding FlightPlan.FlightNumber}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent.Teal}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="TYPE: " FontSize="10" Foreground="{StaticResource Text.Disabled}"/>
                                        <TextBlock Text="{Binding FlightPlan.AircraftType}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="ROUTE: " FontSize="10" Foreground="{StaticResource Text.Disabled}"/>
                                        <TextBlock Text="{Binding FlightPlan.Origin}" FontSize="11" FontWeight="Black" Foreground="{StaticResource Accent.Brand}"/>
                                        <TextBlock Text=" ➔ " FontSize="11" Foreground="{StaticResource Text.Disabled}"/>
                                        <TextBlock Text="{Binding FlightPlan.Destination}" FontSize="11" FontWeight="Black" Foreground="{StaticResource Accent.Brand}"/>
                                        <TextBlock Text=" (ALT: " FontSize="10" Foreground="{StaticResource Text.Disabled}" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding FlightPlan.Alternate}" FontSize="10" Foreground="{StaticResource Text.Secondary}"/>
                                        <TextBlock Text=")" FontSize="10" Foreground="{StaticResource Text.Disabled}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="CRZ: " FontSize="10" Foreground="{StaticResource Text.Disabled}"/>
                                        <TextBlock Text="{Binding FlightPlan.CruiseAltitude}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="ETE: " FontSize="10" Foreground="{StaticResource Text.Disabled}"/>
                                        <TextBlock Text="{Binding FlightPlan.Ete}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Sky Anchor Corridor Status -->
                                <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6"
                                        Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SKY ANCHOR CORRIDOR:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                            <TextBlock Text="{Binding FlightPlan.SkyAnchorPhaseText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding FlightPlan.SkyAnchorDistanceText}" FontSize="10" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- FMC Winds Export Buttons -->
                                <TextBlock Text="FMC WINDS ALOFT UPLINK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" Margin="0,2,0,4"
                                           Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}"/>
                                <Grid Margin="0,0,0,4" Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" Content="PMDG .wx" Command="{Binding FlightPlan.ExportPmdgCommand}" FontSize="10" Padding="4,3" Margin="0,0,3,0"/>
                                    <ui:Button Grid.Column="1" Content="Fenix JSON" Command="{Binding FlightPlan.ExportFenixCommand}" FontSize="10" Padding="4,3" Margin="0,0,3,0"/>
                                    <ui:Button Grid.Column="2" Content="Export CSV" Command="{Binding FlightPlan.ExportCsvCommand}" FontSize="10" Padding="4,3"/>
                                </Grid>
                                <TextBlock Text="{Binding FlightPlan.ExportStatusMessage}" FontSize="9" Foreground="{StaticResource Accent.Teal}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"
                                           Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}"/>

                                <!-- Dispatch Weather Briefing Package (FR-F6) -->
                                <ui:Button Content="📄 VIEW DISPATCH BRIEFING PACKAGE (PDF / NAVLOG)" 
                                           Command="{Binding FlightPlan.OpenDispatchBriefingCommand}"
                                           Background="#1E293B" BorderBrush="{StaticResource Accent.Brand}" BorderThickness="1"
                                           Foreground="{StaticResource Accent.Brand}" FontWeight="Bold" FontSize="10" Padding="6,5" Margin="0,0,0,6"
                                           HorizontalAlignment="Stretch" Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}"/>

                                <!-- Corridor Waypoints -->
                                <TextBlock Text="CORRIDOR WAYPOINTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,4"
                                           Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}"/>
                                <Grid Margin="0,0,0,4" Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="WAYPOINT" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="1" Text="ALT" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="2" Text="WIND" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="3" Text="TEMP" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding FlightPlan.Waypoints}"
                                              Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Identifier}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Altitude}" FontSize="9" Foreground="{StaticResource Text.Secondary}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Wind}" FontSize="9" Foreground="{StaticResource Accent.Teal}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Temperature}" FontSize="9" Foreground="{StaticResource Text.Primary}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Lightning & Storms -->
                    <TabItem Header="⚡ STORMS &amp; CELLS" FontSize="11" FontWeight="Bold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Strikes:" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.LightningCount}" Foreground="#FFD700" FontWeight="Bold" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Closest Strike:" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.ClosestStrike}" Foreground="#FFD700" FontWeight="Bold" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Storm Cells:" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.StormCellCount}" Foreground="#FF4757" FontWeight="Bold" FontSize="11"/>
                                </Grid>

                                <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,4,0,8"/>

                                <TextBlock Text="RECENT STRIKES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LAT" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="1" Text="LON" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="2" Text="DIST" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="3" Text="TIME" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding WeatherDisplay.LightningStrikes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Latitude}" FontSize="9" Foreground="#FFD700"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Longitude}" FontSize="9" Foreground="#FFD700"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Distance}" FontSize="9" Foreground="#FFD700"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Time}" FontSize="9" Foreground="#FFD700"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 3: Sandbox / Manual Scenario Studio -->
                    <TabItem Header="🛠️ SANDBOX STUDIO" FontSize="11" FontWeight="Bold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <StackPanel>
                                <!-- Status Banner -->
                                <Border Background="#1A8B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="MANUAL SCENARIO STUDIO" FontSize="9" FontWeight="Bold" Foreground="#A78BFA"/>
                                            <TextBlock Text="{Binding SandboxStatusText}" FontSize="12" FontWeight="Black" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Content="Live Wx" Command="{Binding ExitSandboxModeCommand}" FontSize="10" Padding="8,4" Margin="0,0,4,0"/>
                                            <ui:Button Content="Apply" Command="{Binding ApplyCustomSandboxCommand}" FontSize="10" Padding="8,4" FontWeight="Bold" Background="#8B5CF6" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Quick Extreme Approach Presets -->
                                <TextBlock Text="EXTREME APPROACH PRESETS (ONE-CLICK)" Style="{StaticResource SubHeader}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 0 -->
                                    <ui:Button Grid.Row="0" Grid.Column="0" Command="{Binding ApplySandboxPresetCommand}" CommandParameter="fog" Margin="0,0,4,4" Padding="6,8" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🌁 CAT III Fog" FontSize="10" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="RVR 150m · 0ft Clg" FontSize="8" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Grid.Row="0" Grid.Column="1" Command="{Binding ApplySandboxPresetCommand}" CommandParameter="crosswind" Margin="2,0,2,4" Padding="6,8" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="💨 35G50 Cross" FontSize="10" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="090°/35kt · G50kt" FontSize="8" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Grid.Row="0" Grid.Column="2" Command="{Binding ApplySandboxPresetCommand}" CommandParameter="supercell" Margin="4,0,0,4" Padding="6,8" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="⚡ Supercell" FontSize="10" FontWeight="Black" Foreground="#EF4444" HorizontalAlignment="Center"/>
                                            <TextBlock Text="TSRA · CAPE 3800" FontSize="8" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>

                                    <!-- Row 1 -->
                                    <ui:Button Grid.Row="1" Grid.Column="0" Command="{Binding ApplySandboxPresetCommand}" CommandParameter="mountain_wave" Margin="0,0,4,0" Padding="6,8" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🏔️ Mountain CAT" FontSize="10" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Sev CAT · 135kt Jet" FontSize="8" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Grid.Row="1" Grid.Column="1" Command="{Binding ApplySandboxPresetCommand}" CommandParameter="severe_icing" Margin="2,0,2,0" Padding="6,8" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="❄️ Severe Icing" FontSize="10" FontWeight="Black" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                                            <TextBlock Text="-2°C FZRA · OVC" FontSize="8" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Grid.Row="1" Grid.Column="2" Command="{Binding ApplySandboxPresetCommand}" CommandParameter="clear_calm" Margin="4,0,0,0" Padding="6,8" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="☀️ CAVOK Fair" FontSize="10" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Center"/>
                                            <TextBlock Text="4kt · 50km Vis · SKC" FontSize="8" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>

                                <!-- Manual Scenario Tuning -->
                                <TextBlock Text="CUSTOM ATMOSPHERE TUNER" Style="{StaticResource SubHeader}" Margin="0,4,0,6"/>

                                <!-- Wind -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Wind Direction" Style="{StaticResource DataLabel}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="360" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding SandboxWindDirection, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SandboxWindDirection, StringFormat={}{0:0}°}" Style="{StaticResource DataValue}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Wind Speed" Style="{StaticResource DataLabel}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="80" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SandboxWindSpeed, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SandboxWindSpeed, StringFormat={}{0:0} kt}" Style="{StaticResource DataValue}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Wind Gusts" Style="{StaticResource DataLabel}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SandboxWindGust, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SandboxWindGust, StringFormat={}{0:0} kt}" Style="{StaticResource DataValue}" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Temp & Altimeter -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Temperature" Style="{StaticResource DataLabel}"/>
                                    <Slider Grid.Column="1" Minimum="-40" Maximum="50" TickFrequency="1" Value="{Binding SandboxTemperature, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SandboxTemperature, StringFormat={}{0:0}°C}" Style="{StaticResource DataValue}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="QNH / Altimeter" Style="{StaticResource DataLabel}"/>
                                    <Slider Grid.Column="1" Minimum="950" Maximum="1050" TickFrequency="1" Value="{Binding SandboxPressure, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SandboxPressure, StringFormat={}{0:0} hPa}" Style="{StaticResource DataValue}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Visibility" Style="{StaticResource DataLabel}"/>
                                    <Slider Grid.Column="1" Minimum="100" Maximum="20000" TickFrequency="500" Value="{Binding SandboxVisibility, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SandboxVisibility, StringFormat={}{0:0} m}" Style="{StaticResource DataValue}" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Turbulence & Icing -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Turbulence" Style="{StaticResource DataLabel}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding SandboxTurbulence, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SandboxTurbulence, StringFormat={}{0:P0}}" Style="{StaticResource DataValue}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Icing Severity" Style="{StaticResource DataLabel}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding SandboxIcing, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SandboxIcing, StringFormat={}{0:P0}}" Style="{StaticResource DataValue}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Convective Thunderstorm" Style="{StaticResource DataLabel}"/>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SandboxThunderstorm, Mode=TwoWay}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Instant Snap (Skip Smoothing)" Style="{StaticResource DataLabel}"/>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SandboxInstantTransition, Mode=TwoWay}" HorizontalAlignment="Right"/>
                                </Grid>

                                <ui:Button Content="⚡ INJECT CUSTOM SCENARIO INTO MSFS"
                                           Command="{Binding ApplyCustomSandboxCommand}"
                                           FontWeight="Black"
                                           Background="#8B5CF6"
                                           Foreground="White"
                                           HorizontalAlignment="Stretch"
                                           Padding="10,8"
                                           Margin="0,4,0,8"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Row 1, Col 0: Radar Mosaic Overlay & Cloud Layers -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TacticalPanel}" Margin="0,5,5,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RADAR &amp; SYNOPTIC MAP" Style="{StaticResource HeaderLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding Radar.RadarTimestamp}" FontSize="10" Foreground="{StaticResource Accent.Teal}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ui:Button Content="Radar" FontSize="9" Padding="4,2" Command="{Binding Radar.ToggleLayerCommand}" CommandParameter="RADAR" Margin="0,0,2,0"/>
                                <ui:Button Content="Isobars" FontSize="9" Padding="4,2" Command="{Binding Radar.ToggleLayerCommand}" CommandParameter="ISOBARS" Margin="0,0,2,0"/>
                                <ui:Button Content="Barbs" FontSize="9" Padding="4,2" Command="{Binding Radar.ToggleLayerCommand}" CommandParameter="WINDS" Margin="0,0,2,0"/>
                                <ui:Button Content="Airports" FontSize="9" Padding="4,2" Command="{Binding Radar.ToggleLayerCommand}" CommandParameter="STATIONS" Margin="0,0,6,0"/>
                                <ui:Button Content="50" FontSize="9" Padding="4,2" Command="{Binding Radar.SetRangeCommand}" CommandParameter="50" Margin="0,0,2,0"/>
                                <ui:Button Content="100" FontSize="9" Padding="4,2" Command="{Binding Radar.SetRangeCommand}" CommandParameter="100" Margin="0,0,2,0"/>
                                <ui:Button Content="250" FontSize="9" Padding="4,2" Command="{Binding Radar.SetRangeCommand}" CommandParameter="250"/>
                            </StackPanel>
                        </Grid>

                        <!-- Canvas Radar View -->
                        <Border Style="{StaticResource InsetWell}" Padding="2" Margin="0,0,0,6" ClipToBounds="True">
                            <Viewbox Stretch="Uniform" MaxHeight="220">
                                <Canvas Width="768" Height="768" Background="{StaticResource Bg.Inset}">
                                    <!-- Radar Mosaic Tiles -->
                                    <ItemsControl ItemsSource="{Binding Radar.RadarTiles}" Visibility="{Binding Radar.ShowRadar, Converter={StaticResource BooleanToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="768" Height="768"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Image}" Width="256" Height="256" Stretch="Fill"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Synoptic Isobar Contours -->
                                    <ItemsControl ItemsSource="{Binding Radar.Isobars}" Visibility="{Binding Radar.ShowIsobars, Converter={StaticResource BooleanToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="768" Height="768"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Canvas Width="768" Height="768">
                                                    <Path Data="{Binding SvgPath}" Stroke="{Binding StrokeColor}" StrokeThickness="1.5"/>
                                                    <Border Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}" Background="#E6030712" BorderBrush="#3300F0FF" BorderThickness="1" CornerRadius="2" Padding="3,1">
                                                        <TextBlock Text="{Binding Label}" FontSize="8" Foreground="#99D8EE" FontWeight="Bold"/>
                                                    </Border>
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Pressure Centers (High / Low) -->
                                    <ItemsControl ItemsSource="{Binding Radar.PressureCenters}" Visibility="{Binding Radar.ShowIsobars, Converter={StaticResource BooleanToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="768" Height="768"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#E6030712" BorderBrush="{Binding ColorHex}" BorderThickness="1.5" CornerRadius="12" Padding="6,2" Margin="-20,-12,0,0">
                                                    <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="Black" Foreground="{Binding ColorHex}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Dynamic Meteorological Wind Barbs -->
                                    <ItemsControl ItemsSource="{Binding Radar.WindBarbs}" Visibility="{Binding Radar.ShowWindBarbs, Converter={StaticResource BooleanToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="768" Height="768"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Path Data="{Binding SvgPath}" Stroke="#E0F2FE" StrokeThickness="1.5"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Crosshairs -->
                                    <Line X1="0" Y1="384" X2="768" Y2="384" Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="3,6"/>
                                    <Line X1="384" Y1="0" X2="384" Y2="768" Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="3,6"/>

                                    <!-- Range Rings -->
                                    <Ellipse Width="{Binding Radar.Ring25Diameter}" Height="{Binding Radar.Ring25Diameter}"
                                             Canvas.Left="{Binding Radar.Ring25Left}" Canvas.Top="{Binding Radar.Ring25Left}"
                                             Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="2,4"/>
                                    <Ellipse Width="{Binding Radar.Ring50Diameter}" Height="{Binding Radar.Ring50Diameter}"
                                             Canvas.Left="{Binding Radar.Ring50Left}" Canvas.Top="{Binding Radar.Ring50Left}"
                                             Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="2,4"/>
                                    <Ellipse Width="{Binding Radar.Ring100Diameter}" Height="{Binding Radar.Ring100Diameter}"
                                             Canvas.Left="{Binding Radar.Ring100Left}" Canvas.Top="{Binding Radar.Ring100Left}"
                                             Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="2,4"/>
                                    <Ellipse Width="{Binding Radar.Ring250Diameter}" Height="{Binding Radar.Ring250Diameter}"
                                             Canvas.Left="{Binding Radar.Ring250Left}" Canvas.Top="{Binding Radar.Ring250Left}"
                                             Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="2,4"/>

                                    <!-- Station Markers -->
                                    <ItemsControl ItemsSource="{Binding MapStations}" Visibility="{Binding Radar.ShowStations, Converter={StaticResource BooleanToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="768" Height="768"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding SelectCommand}"
                                                        Background="Transparent" BorderThickness="0" Padding="0" Margin="-16,-16,0,0" Cursor="Hand">
                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                        <Ellipse Width="6" Height="6" Fill="#00F0FF" HorizontalAlignment="Center"/>
                                                        <Border Background="#D00B0F19" CornerRadius="2" Padding="2,1" Margin="0,1,0,0">
                                                            <TextBlock Text="{Binding IcaoId}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Center Aircraft Symbol -->
                                    <Polygon Points="384,374 392,392 384,386 376,392" Fill="{StaticResource Accent.Brand}" Stroke="{StaticResource Bg.Deep}" StrokeThickness="1"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,4,0,8"/>

                        <!-- Cloud Layers -->
                        <TextBlock Text="CLOUD LAYERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BASE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="1" Text="TOP" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="2" Text="TYPE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="3" Text="DENS" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="4" Text="SCAT" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding WeatherDisplay.CloudLayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Base}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Top}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="10" Foreground="{StaticResource Accent.Teal}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Density}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Scattering}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Row 1, Col 1: Atmospheric Sounding (Skew-T Profile, Icing & Turbulence) -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TacticalPanel}" Margin="5,5,5,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header with Mode Toggle -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VERTICAL SOUNDING (SKEW-T)" Style="{StaticResource HeaderLabel}" Margin="0"/>
                            <ui:Button Grid.Column="1" Content="Graph / Tables" FontSize="9" Padding="6,2" Command="{Binding Sounding.ToggleModeCommand}"/>
                        </Grid>

                        <!-- Graphical Sounding Profile View -->
                        <StackPanel Visibility="{Binding Sounding.IsGraphicMode, Converter={StaticResource BooleanToVisibility}}">
                            <Border Style="{StaticResource InsetWell}" Padding="2" Margin="0,0,0,6" ClipToBounds="True">
                                <Viewbox Stretch="Uniform" MaxHeight="210">
                                    <Canvas Width="360" Height="240" Background="{StaticResource Bg.Inset}">
                                        <!-- Flight Level Reference Grid Lines & Text -->
                                        <ItemsControl ItemsSource="{Binding Sounding.StandardLevels}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="360" Height="240"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas Width="360" Height="240">
                                                        <Line X1="0" Y1="{Binding Y}" X2="360" Y2="{Binding Y}" Stroke="#1E293B" StrokeThickness="1" StrokeDashArray="2,4"/>
                                                        <TextBlock Canvas.Left="4" Canvas.Top="{Binding Y}" Text="{Binding FlightLevelName}" FontSize="8" Foreground="#64748B" Margin="0,-6,0,0"/>
                                                        <TextBlock Canvas.Left="260" Canvas.Top="{Binding Y}" Text="{Binding WindText}" FontSize="8" Foreground="{StaticResource Accent.Teal}" Margin="0,-6,0,0"/>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Volumetric Cloud Blocks -->
                                        <ItemsControl ItemsSource="{Binding Sounding.CloudBlocks}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="360" Height="240"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas Width="360" Height="240">
                                                        <Border Canvas.Left="35" Canvas.Top="{Binding Y}" Width="220" Height="{Binding Height}"
                                                                Background="#38BDF8" Opacity="{Binding Opacity}" CornerRadius="3"
                                                                BorderBrush="#00F0FF" BorderThickness="1">
                                                            <TextBlock Text="{Binding Label}" FontSize="8" Foreground="#FFFFFF" Margin="4,1" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Atmospheric Hazard Bands (Icing / Turbulence) -->
                                        <ItemsControl ItemsSource="{Binding Sounding.HazardBands}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="360" Height="240"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas Width="360" Height="240">
                                                        <Border Canvas.Left="260" Canvas.Top="{Binding Y}" Width="95" Height="{Binding Height}"
                                                                Background="{Binding ColorHex}" Opacity="0.35" CornerRadius="2"
                                                                BorderBrush="{Binding ColorHex}" BorderThickness="1">
                                                            <TextBlock Text="{Binding Label}" FontSize="8" FontWeight="Bold" Foreground="{Binding ColorHex}" Margin="3,1" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 0°C Freezing Level Line & Badge -->
                                        <Line X1="0" Y1="{Binding Sounding.FreezingLevelY}" X2="360" Y2="{Binding Sounding.FreezingLevelY}" Stroke="#00F0FF" StrokeThickness="1.5" StrokeDashArray="3,3"/>
                                        <Border Canvas.Left="6" Canvas.Top="{Binding Sounding.FreezingLevelY}" Background="#E6030712" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="2" Padding="3,1" Margin="0,-12,0,0">
                                            <TextBlock Text="{Binding Sounding.FreezingLevelLabel}" FontSize="7" FontWeight="Bold" Foreground="#00F0FF"/>
                                        </Border>

                                        <!-- Aircraft Current Altitude Indicator -->
                                        <Canvas Visibility="{Binding Sounding.HasAircraftAltitude, Converter={StaticResource BooleanToVisibility}}">
                                            <Line X1="0" Y1="{Binding Sounding.AircraftLevelY}" X2="360" Y2="{Binding Sounding.AircraftLevelY}" Stroke="#E81CFF" StrokeThickness="1.5"/>
                                            <Polygon Points="350,0 358,6 350,12" Fill="#E81CFF" Canvas.Left="0" Canvas.Top="{Binding Sounding.AircraftLevelY}" Margin="0,-6,0,0"/>
                                        </Canvas>

                                        <!-- Temperature Lapse Rate Curve (Orange) -->
                                        <Path Data="{Binding Sounding.TemperatureSvg}" Stroke="#F97316" StrokeThickness="2"/>

                                        <!-- Dewpoint Curve (Cyan) -->
                                        <Path Data="{Binding Sounding.DewpointSvg}" Stroke="#00F0FF" StrokeThickness="2"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <!-- Profile Legend -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="━ Temp (°C)" Foreground="#F97316" FontSize="8" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="━ Dewpoint" Foreground="#00F0FF" FontSize="8" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="┅ 0°C Level" Foreground="#38BDF8" FontSize="8" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="☁ Clouds" Foreground="#94A3B8" FontSize="8" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="⚡ Hazard Bands" Foreground="#EF4444" FontSize="8" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Icing Layers Table -->
                        <TextBlock Text="ICING LAYERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent.Teal}" Margin="0,2,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BASE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="1" Text="TOP" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="2" Text="SEVERE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="3" Text="TYPE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding WeatherDisplay.IcingLayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Base}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Top}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Severity}" FontSize="10" Foreground="{StaticResource Accent.Teal}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Type}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,6,0,6"/>

                        <!-- Turbulence Layers Table -->
                        <TextBlock Text="TURBULENCE LAYERS" FontSize="10" FontWeight="Bold" Foreground="#FFA502" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BASE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="1" Text="TOP" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="2" Text="SEVERE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="3" Text="TYPE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding WeatherDisplay.TurbulenceLayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Base}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Top}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Severity}" FontSize="10" Foreground="#FFA502"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Type}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Row 1, Col 2: Winds Aloft & Hazards -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TacticalPanel}" Margin="5,5,5,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Winds Aloft -->
                        <TextBlock Text="WINDS ALOFT PROFILE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ALT" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="1" Text="DIR" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="2" Text="SPD" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="3" Text="TEMP" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding WeatherDisplay.WindLayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Altitude}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Direction}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Speed}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Temperature}" FontSize="10" Foreground="{StaticResource Accent.Teal}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,8,0,8"/>

                        <!-- Hazards / SIGMETs -->
                        <TextBlock Text="HAZARDS &amp; SIGMETs" FontSize="11" FontWeight="Bold" Foreground="#FF4757" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TYPE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="1" Text="SEV" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="2" Text="TO" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="3" Text="DESC" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding WeatherDisplay.Hazards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Type}" FontSize="9" Foreground="#FF4757"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Severity}" FontSize="9" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ValidTo}" FontSize="9" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Description}" FontSize="9" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,8,0,8"/>

                        <!-- Live Traffic & Wake Monitor -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="LIVE TRAFFIC &amp; WAKE (15 NM)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Grid.Column="1" Text="{Binding TrafficStatusText}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                        </Grid>

                        <Border Visibility="{Binding HasWakeEncounter, Converter={StaticResource BooleanToVisibility}}"
                                Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                            <TextBlock Text="{Binding WakeStatusText}" FontSize="10" FontWeight="Black" Foreground="#EF4444" TextWrapping="Wrap"/>
                        </Border>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CALLSIGN" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="1" Text="DIST" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="2" Text="BRG" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="3" Text="ΔALT" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock Grid.Column="4" Text="CLASS" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding NearbyTrafficList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Callsign}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DistanceNm, StringFormat={}{0:F1}nm}" FontSize="9" Foreground="#38BDF8"/>
                                        <TextBlock Grid.Column="2" Text="{Binding RelativeBearingDegrees, StringFormat={}{0:000}°}" FontSize="9" Foreground="{StaticResource Text.Secondary}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding AltitudeDeltaFeet, StringFormat={}{0:+0;-0}ft}" FontSize="9" Foreground="{StaticResource Text.Secondary}"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <TextBlock Text="{Binding WeightClass}" FontSize="9" Foreground="{StaticResource Text.Secondary}"/>
                                            <TextBlock Text=" ⚠️ WAKE" FontSize="9" FontWeight="Bold" Foreground="#EF4444" Visibility="{Binding IsInWakeZone, Converter={StaticResource BooleanToVisibility}}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Sidebar: Station, Log & Customization -->
            <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource TacticalPanel}" Margin="5,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="STATION SELECT" Style="{StaticResource HeaderLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

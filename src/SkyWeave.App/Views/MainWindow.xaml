                                    <TextBlock Text="Installed Extensions" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                                    <ui:Button Grid.Column="1" Content="🔄 Rescan" Command="{Binding Settings.RescanPluginsCommand}" FontSize="9" Padding="6,2" Margin="0,0,4,0"/>
                                    <ui:Button Grid.Column="2" Content="📁 Open Folder" Command="{Binding Settings.OpenPluginsFolderCommand}" FontSize="9" Padding="6,2"/>
                                </Grid>
                                
                                <Border Background="#1A0F172A" BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                                    <TextBlock Text="Drop community .dll plugins into the plugins directory. Extensions inject custom cloud layers, turbulence zones, volcanic ash, or radar echoes safely without crashing the simulator."
                                               FontSize="9" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Settings.InstalledPlugins}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#221E293B" BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding PluginName}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource Accent.Brand}"/>
                                                            <TextBlock Text="{Binding Version, StringFormat=' (v{0})'}" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                                            <TextBlock Text="{Binding Author, StringFormat=' by {0}'}" FontSize="9" Foreground="{StaticResource Accent.Teal}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="9" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Footer -->
        <Border Grid.Row="3" Background="#990F172A" BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SeverityChip}" Background="{StaticResource Accent.Brand}" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Connection.ModeBadgeText}" FontSize="9" FontWeight="Black" Foreground="White"/>
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.RawMetar}" Foreground="{StaticResource Text.Secondary}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="{Binding Connection.AircraftPosition}" Foreground="{StaticResource Text.Secondary}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>

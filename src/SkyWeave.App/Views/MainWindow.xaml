                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" Content="▶ Replay ERA5" Command="{Binding ApplyHistoricalReplayCommand}" FontWeight="Bold" Margin="0,0,3,0" Padding="4,5"/>
                                    <ui:Button Grid.Column="1" Content="⚡ Live Weather" Command="{Binding ReturnToLiveWeatherCommand}" Margin="3,0,0,0" Padding="4,5"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Column 2: Web EFB, Plugins & Relocated Session Log -->
                    <Border Grid.Column="2" Style="{StaticResource TacticalPanel}" Margin="4,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Web EFB Companion -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="WEB EFB &amp; TABLET COMPANION" Style="{StaticResource HeaderLabel}"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             Fill="{Binding IsEfbRunning, Converter={StaticResource BoolToBrush}}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding EfbStatusText}"
                                               FontSize="11" Foreground="{StaticResource Text.Primary}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" Content="Open EFB" Command="{Binding OpenEfbInBrowserCommand}"
                                               Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                                    <ui:Button Grid.Column="1" Content="Copy URL" Command="{Binding CopyEfbUrlCommand}"
                                               Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                                    <ui:Button Grid.Column="2" Content="Retry" Command="{Binding RestartEfbCommand}"
                                               Padding="8,4" FontSize="11"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="Allow LAN Access" Style="{StaticResource DataLabel}"/>
                                        <TextBlock Text="iPad / Tablet on Wi-Fi (Read-only)" FontSize="9" Foreground="{StaticResource Text.Secondary}"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.AllowLanEfbAccess, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Style="{StaticResource InsetWell}" Padding="6,4" Margin="0,2,0,0"
                                        Visibility="{Binding Settings.AllowLanEfbAccess, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="TABLET WI-FI URL:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}"/>
                                        <TextBlock Text="{Binding EfbLanAddressText}" FontSize="10" FontFamily="Consolas, Courier New"
                                                   Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Community Plugins -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="COMMUNITY PLUGINS" Style="{StaticResource HeaderLabel}" Margin="0" VerticalAlignment="Center"/>
                                    <ui:Button Grid.Column="1" Content="🔄 Rescan" Command="{Binding Settings.RescanPluginsCommand}" FontSize="9" Padding="6,2" Margin="0,0,4,0"/>
                                    <ui:Button Grid.Column="2" Content="📁 Folder" Command="{Binding Settings.OpenPluginsFolderCommand}" FontSize="9" Padding="6,2"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Settings.InstalledPlugins}" MaxHeight="90">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#221E293B" BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding PluginName}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource Accent.Brand}"/>
                                                            <TextBlock Text="{Binding Version, StringFormat=' (v{0})'}" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="9" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Relocated Diagnostics & Session Log -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Separator Grid.Row="0" Background="{StaticResource Stroke.Subtle}" Margin="0,0,0,6"/>

                                <Grid Grid.Row="0" Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DIAGNOSTICS &amp; SESSION LOG" Style="{StaticResource HeaderLabel}" Margin="0" VerticalAlignment="Center"/>
                                    <ui:Button Grid.Column="1" Content="Copy" FontSize="9" Padding="6,2" Margin="0,0,4,0" Command="{Binding CopyLogCommand}"/>
                                    <ui:Button Grid.Column="2" Content="Logs Folder" FontSize="9" Padding="6,2" Command="{Binding OpenLogFolderCommand}"/>
                                </Grid>

                                <Border Grid.Row="1" Style="{StaticResource InsetWell}" Padding="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding LogMessages}" FontFamily="Consolas, Courier New" FontSize="9"
                                                   Foreground="{StaticResource Accent.Brand}" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Footer -->
        <Border Grid.Row="3" Background="#B3080C14" BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SeverityChip}" Background="{StaticResource Accent.Brand}" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Connection.ModeBadgeText}" FontSize="9" FontWeight="Black" Foreground="#080C14"/>
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.RawMetar}" Foreground="{StaticResource Text.Secondary}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="{Binding Connection.AircraftPosition}" Foreground="{StaticResource Text.Secondary}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>

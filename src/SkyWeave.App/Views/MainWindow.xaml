<ui:FluentWindow x:Class="SkyWeave.App.Views.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:vm="clr-namespace:SkyWeave.App.ViewModels"
                  xmlns:local="clr-namespace:SkyWeave.App"
                  xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  mc:Ignorable="d"
                  Title="SkyWeave - Real Weather Engine for MSFS 2024"
                  Width="1400" Height="920"
                  MinWidth="1200" MinHeight="720"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="Mica"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="Auto"/> <!-- Header Controls & Quick Switcher -->
            <RowDefinition Height="*"/>    <!-- MFD Tabbed Workspace -->
            <RowDefinition Height="Auto"/> <!-- Status Footer -->
        </Grid.RowDefinitions>

        <!-- Native Windows 11 TitleBar with Snap Layouts support -->
        <ui:TitleBar Grid.Row="0"
                     Title="SkyWeave">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/SkyWeave.ico"/>
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Background="{StaticResource Accent.Brand}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionText}" FontSize="10" Foreground="#080C14" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Real Weather Engine for MSFS 2024" FontSize="11" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Tactical Glass Header Bar -->
        <Border Grid.Row="1" Background="#B3090E17" BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Info & Quick Station Search -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="8,4" CornerRadius="6" Background="{StaticResource Accent.Brand.Glow}" BorderBrush="{StaticResource Accent.Brand}" BorderThickness="1">
                        <TextBlock Text="SKYWEAVE" FontSize="16" FontWeight="Black" Foreground="{StaticResource Accent.Brand}" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Global Quick Station Switcher -->
                    <Border Background="{StaticResource Bg.Inset}" BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ICAO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}" VerticalAlignment="Center" Margin="2,0,6,0"/>
                            <TextBox Text="{Binding Connection.ManualStation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="11" FontWeight="Bold" Width="65" Padding="4,2" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            <ui:Button Content="Go" Command="{Binding Connection.UseManualStationCommand}"
                                       FontWeight="Bold" FontSize="10" Padding="8,2" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Connection.SelectedAirportName}" FontSize="11" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="8,0,16,0" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                </StackPanel>

                <!-- Telemetry & Network Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- Zulu Clock -->
                    <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ZULU " FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ZuluTimeText}" FontSize="11" FontFamily="Consolas, Courier New" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Sky Anchor Flight Phase -->
                    <Border Background="#2638BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Connection.SkyAnchorPhaseBadge}" FontSize="9" FontWeight="Black" Foreground="#38BDF8"/>
                    </Border>

                    <!-- Online ATC Network Badge -->
                    <Border Visibility="{Binding IsOnlineNetworkActive, Converter={StaticResource BooleanToVisibility}}"
                            Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="Online ATC / AI network client detected (METAR ground truth preserved)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OnlineNetworkName}" FontSize="9" FontWeight="Black" Foreground="#10B981" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Historical Replay Badge -->
                    <Border Visibility="{Binding IsHistoricalMode, Converter={StaticResource BooleanToVisibility}}"
                            Background="#26F59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="ERA5 Historical Reanalysis Replay Active">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏳ " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Text="HISTORICAL" FontSize="9" FontWeight="Black" Foreground="#F59E0B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Sandbox Studio Badge -->
                    <Border Visibility="{Binding IsSandboxMode, Converter={StaticResource BooleanToVisibility}}"
                            Background="#268B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="Sandbox Custom Weather Scenario Active">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛠️ " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Text="SANDBOX" FontSize="9" FontWeight="Black" Foreground="#A78BFA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Traffic Badge -->
                    <Border Visibility="{Binding Connection.IsConnected, Converter={StaticResource BooleanToVisibility}}"
                            Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="{Binding TrafficStatusText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✈️ " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TrafficCount, StringFormat={}{0} TRAFFIC}" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Wake Alert Badge -->
                    <Border Visibility="{Binding HasWakeEncounter, Converter={StaticResource BooleanToVisibility}}"
                            Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="{Binding WakeStatusText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Text="WAKE" FontSize="9" FontWeight="Black" Foreground="#EF4444" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- SimConnect Connection Pill -->
                    <Border Background="#1A1E293B" BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{Binding Connection.IsConnected, Converter={StaticResource BoolToBrush}}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Connection.StatusText}" Foreground="{StaticResource Text.Primary}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tactical Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Connect"
                               Command="{Binding Connection.ConnectCommand}"
                               IsEnabled="{Binding Connection.IsConnected, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Inverse}"
                               Margin="0,0,6,0" Padding="12,5" FontSize="11"/>
                    <Primitives:ToggleButton Content="Inject"
                                             Command="{Binding Connection.StartWeatherCommand}"
                                             IsChecked="{Binding Connection.IsInjecting, Mode=OneWay}"
                                             FontWeight="Bold" FontSize="11"
                                             Margin="0,0,6,0" Padding="12,5"/>
                    <Primitives:ToggleButton Content="FREEZE"
                                             Command="{Binding Connection.ToggleFreezeCommand}"
                                             IsChecked="{Binding Connection.IsFrozen, Mode=OneWay}"
                                             FontWeight="Black" FontSize="11"
                                             Foreground="{StaticResource Data.Caution}"
                                             Margin="0,0,6,0" Padding="10,5"/>
                    <Primitives:ToggleButton Content="Passive"
                                             Command="{Binding Connection.StartPassiveCommand}"
                                             IsChecked="{Binding Connection.IsPassiveMode, Mode=OneWay}"
                                             FontSize="11"
                                             Margin="0,0,6,0" Padding="10,5"/>
                    <ui:Button Content="Refresh"
                               Command="{Binding Connection.RefreshNowCommand}"
                               Margin="0,0,6,0" Padding="10,5" FontSize="11"/>
                    <ui:Button Content="Stop"
                               Command="{Binding Connection.StopWeatherCommand}"
                               Padding="10,5" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Modern MFD Navigation Tabbed Workspace -->
        <TabControl Grid.Row="2"
                    Style="{StaticResource MfdTabControl}"
                    ItemContainerStyle="{StaticResource MfdTabItem}"
                    Margin="10,6,10,6">

            <!-- ====================================================================== -->
            <!-- TAB 1: FLIGHT DECK (Cockpit WX)                                        -->
            <!-- ====================================================================== -->
            <TabItem Header="🛰️ FLIGHT DECK">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Current Conditions & TAF Strip -->
                    <Border Grid.Column="0" Style="{StaticResource TacticalPanel}" Margin="0,0,6,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Header & Category Badge -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SURFACE OBSERVATION" Style="{StaticResource HeaderLabel}" Margin="0"/>
                                    <Border Grid.Column="1" Background="{Binding WeatherDisplay.FlightCategory, Converter={StaticResource FlightCategoryToBrush}}"
                                            CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WeatherDisplay.FlightCategory}" FontWeight="Black" FontSize="11" Foreground="White"/>
                                    </Border>
                                </Grid>

                                <!-- Hero Station Banner -->
                                <Border Style="{StaticResource InsetWell}" Padding="10,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding WeatherDisplay.StationId}" FontSize="22" FontWeight="Black" Foreground="{StaticResource Accent.Brand}"/>
                                            <TextBlock Text="{Binding Connection.SelectedAirportName}" FontSize="10" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WeatherDisplay.SourceModel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding WeatherDisplay.DataAge, StringFormat='Age: {0}'}" FontSize="9" Foreground="{StaticResource Text.Disabled}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Meteorological KPI Grid -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Temp / Dewpoint -->
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InsetWell}" Padding="8,6" Margin="0,0,4,4">
                                        <StackPanel>
                                            <TextBlock Text="TEMP / DEW" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding WeatherDisplay.Temperature}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                                <TextBlock Text=" / " FontSize="12" Foreground="{StaticResource Text.Disabled}"/>
                                                <TextBlock Text="{Binding WeatherDisplay.Dewpoint}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent.Brand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Surface Wind -->
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InsetWell}" Padding="8,6" Margin="4,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="SURFACE WIND" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                            <TextBlock Text="{Binding WeatherDisplay.Wind}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Altimeter / QNH -->
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource InsetWell}" Padding="8,6" Margin="0,4,4,4">
                                        <StackPanel>
                                            <TextBlock Text="ALTIMETER / QNH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                            <TextBlock Text="{Binding WeatherDisplay.Altimeter}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Visibility -->
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InsetWell}" Padding="8,6" Margin="4,4,0,4">
                                        <StackPanel>
                                            <TextBlock Text="VISIBILITY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                            <TextBlock Text="{Binding WeatherDisplay.Visibility}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Ceiling -->
                                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource InsetWell}" Padding="8,6" Margin="0,4,4,0">
                                        <StackPanel>
                                            <TextBlock Text="CEILING" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                            <TextBlock Text="{Binding WeatherDisplay.Ceiling}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Relative Humidity -->
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource InsetWell}" Padding="8,6" Margin="4,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="HUMIDITY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                            <TextBlock Text="{Binding WeatherDisplay.Humidity}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Live Sim Readback Banner -->
                                <Border Style="{StaticResource InsetWell}" Padding="8,4" Margin="0,0,0,6"
                                        Visibility="{Binding Connection.HasSimWeatherReadback, Converter={StaticResource BooleanToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SIM READBACK: " FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Connection.SimWeatherInfo}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Live ATIS Broadcast Row -->
                                <Border Style="{StaticResource InsetWell}" Padding="8,4" Margin="0,0,0,8"
                                        Visibility="{Binding WeatherDisplay.HasAtis, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding WeatherDisplay.AtisBadgeText}" Foreground="#10B981" FontWeight="Bold" FontSize="9"/>
                                        </Border>
                                        <TextBlock Text="{Binding WeatherDisplay.AtisSummaryText}" ToolTip="{Binding WeatherDisplay.AtisRawText}" FontSize="10" Style="{StaticResource DataValue}"/>
                                    </StackPanel>
                                </Border>

                                <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,2,0,8"/>

                                <!-- Raw METAR Inset Box -->
                                <TextBlock Text="RAW METAR OBSERVATION" Style="{StaticResource HeaderLabel}" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource InsetWell}" Padding="8,6" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding WeatherDisplay.RawMetar}" FontFamily="Consolas, Courier New" FontSize="10" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap"/>
                                </Border>

                                <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,2,0,8"/>

                                <!-- TAF Section -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TAF TERMINAL FORECAST" Style="{StaticResource HeaderLabel}" Margin="0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Style="{StaticResource SeverityChip}" Background="{Binding Taf.TafFlightCategory, Converter={StaticResource FlightCategoryToChipBrush}}">
                                            <TextBlock Text="{Binding Taf.TafFlightCategory}" FontSize="9" FontWeight="Bold" Foreground="{Binding Taf.TafFlightCategory, Converter={StaticResource FlightCategoryToBrush}}"/>
                                        </Border>
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource Data.Caution}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                 Visibility="{Binding Taf.TafDivergence, Converter={StaticResource BooleanToVisibility}}" ToolTip="METAR and TAF flight categories diverge"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource InsetWell}" Padding="8,6" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Taf.TafText}" FontFamily="Consolas, Courier New" FontSize="9" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap" MaxHeight="60"/>
                                </Border>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Validity:" Style="{StaticResource DataLabel}" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Taf.TafValidity}" FontSize="10" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Wind / Vis:" Style="{StaticResource DataLabel}" FontSize="10"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Taf.TafWind}" FontSize="10" Foreground="{StaticResource Text.Primary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Taf.TafVisibility}" FontSize="10" Foreground="{StaticResource Text.Secondary}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="FORECAST TIMELINE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,4"/>
                                <ItemsControl ItemsSource="{Binding Taf.TafGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" BorderThickness="1" Margin="0,0,4,0"
                                                    BorderBrush="{Binding FlightCategory, Converter={StaticResource FlightCategoryToBrush}}"
                                                    Background="{Binding FlightCategory, Converter={StaticResource FlightCategoryToChipBrush}}"
                                                    Opacity="{Binding BlockOpacity}"
                                                    Width="76" Height="44" Padding="4,2">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{Binding FlightCategory, Converter={StaticResource FlightCategoryToBrush}}"/>
                                                    <TextBlock Text="{Binding CloudSummary}" FontSize="8" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Wind}" FontSize="8" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Center: Winds Aloft, Clouds & Traffic -->
                    <Grid Grid.Column="1" Margin="6,0,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Atmospheric Structure & Winds Aloft -->
                        <Border Grid.Row="0" Style="{StaticResource TacticalPanel}" Margin="0,0,0,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Winds Aloft -->
                                    <TextBlock Text="WINDS ALOFT PROFILE" Style="{StaticResource HeaderLabel}"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ALTITUDE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                        <TextBlock Grid.Column="1" Text="DIR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                        <TextBlock Grid.Column="2" Text="SPEED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                        <TextBlock Grid.Column="3" Text="TEMP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding WeatherDisplay.WindLayers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Altitude}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Direction}" FontSize="11" Foreground="{StaticResource Text.Primary}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Speed}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Temperature}" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,8,0,8"/>

                                    <!-- Cloud Layers -->
                                    <TextBlock Text="CLOUD LAYERS (MSL)" Style="{StaticResource HeaderLabel}"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="BASE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                        <TextBlock Grid.Column="1" Text="TOP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                        <TextBlock Grid.Column="2" Text="COVER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                        <TextBlock Grid.Column="3" Text="DENS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                        <TextBlock Grid.Column="4" Text="SCAT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding WeatherDisplay.CloudLayers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Base}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Top}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Density}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Scattering}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Bottom: Live Traffic & Wake Alert -->
                        <Border Grid.Row="1" Style="{StaticResource TacticalPanel}" Margin="0,6,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LIVE TRAFFIC &amp; WAKE RADAR (15 NM)" Style="{StaticResource HeaderLabel}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TrafficStatusText}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                                </Grid>

                                <Border Visibility="{Binding HasWakeEncounter, Converter={StaticResource BooleanToVisibility}}"
                                        Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding WakeStatusText}" FontSize="10" FontWeight="Black" Foreground="#EF4444" TextWrapping="Wrap"/>
                                </Border>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CALLSIGN" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="1" Text="DIST" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="2" Text="BRG" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="3" Text="ΔALT" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="4" Text="WAKE / CLASS" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                </Grid>
                                <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding NearbyTrafficList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Callsign}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DistanceNm, StringFormat={}{0:F1}nm}" FontSize="9" Foreground="{StaticResource Accent.Brand}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding RelativeBearingDegrees, StringFormat={}{0:000}°}" FontSize="9" Foreground="{StaticResource Text.Secondary}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding AltitudeDeltaFeet, StringFormat={}{0:+0;-0}ft}" FontSize="9" Foreground="{StaticResource Text.Secondary}"/>
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding WeightClass}" FontSize="9" Foreground="{StaticResource Text.Secondary}"/>
                                                        <TextBlock Text=" ⚠️ WAKE" FontSize="9" FontWeight="Bold" Foreground="#EF4444" Visibility="{Binding IsInWakeZone, Converter={StaticResource BooleanToVisibility}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Right: Weather Indices, Stability & Hazards -->
                    <Border Grid.Column="2" Style="{StaticResource TacticalPanel}" Margin="6,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="WEATHER INDICES &amp; RISK" Style="{StaticResource HeaderLabel}"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Freezing Level:" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.FreezingLevel}" Style="{StaticResource DataValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Precipitation:" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Precipitation}" Style="{StaticResource DataValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Aerosol Density:" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.AerosolDensity}" Style="{StaticResource DataValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CAPE (J/kg):" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.CapeValue}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Lifted Index:" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.LiftedIndexValue}" Foreground="#F97316" FontWeight="Bold" FontSize="11"/>
                                </Grid>

                                <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,2,0,8"/>

                                <!-- Severity Index Bars -->
                                <TextBlock Text="ATMOSPHERIC HAZARD GAUGES" Style="{StaticResource SubHeader}" Margin="0,0,0,6"/>

                                <!-- Icing Index -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Icing Severity:" Style="{StaticResource DataLabel}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding WeatherDisplay.IcingIndex}" FontWeight="Bold" FontSize="11" Foreground="#60A5FA"/>
                                        <ProgressBar Height="5" Value="{Binding WeatherDisplay.IcingIndex, Converter={StaticResource IndexToProgressValue}}" Maximum="100" Margin="0,3,0,0" Foreground="#60A5FA"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Turbulence Index -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Turbulence:" Style="{StaticResource DataLabel}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding WeatherDisplay.TurbulenceIndex}" FontWeight="Bold" FontSize="11" Foreground="#F59E0B"/>
                                        <ProgressBar Height="5" Value="{Binding WeatherDisplay.TurbulenceIndex, Converter={StaticResource IndexToProgressValue}}" Maximum="100" Margin="0,3,0,0" Foreground="#F59E0B"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Thunderstorm Intensity -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Convective TS:" Style="{StaticResource DataLabel}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding WeatherDisplay.ThunderstormIntensity}" FontWeight="Bold" FontSize="11" Foreground="#EF4444"/>
                                        <ProgressBar Height="5" Value="{Binding WeatherDisplay.ThunderstormIntensity, Converter={StaticResource IndexToProgressValue}}" Maximum="100" Margin="0,3,0,0" Foreground="#EF4444"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,4,0,8"/>

                                <!-- Active Hazards / SIGMETs -->
                                <TextBlock Text="ACTIVE SIGMETs &amp; HAZARDS" Style="{StaticResource HeaderLabel}" Foreground="#EF4444"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TYPE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="1" Text="SEV" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="2" Text="TO" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="3" Text="DESC" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding WeatherDisplay.Hazards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Type}" FontSize="9" Foreground="#EF4444" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Severity}" FontSize="9" Foreground="{StaticResource Text.Primary}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ValidTo}" FontSize="9" Foreground="{StaticResource Text.Primary}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Description}" FontSize="9" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,8,0,8"/>

                                <!-- Web EFB Companion Quick Link -->
                                <Border Style="{StaticResource InsetWell}" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="WEB EFB COMPANION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}"/>
                                            <TextBlock Text="{Binding EfbStatusText}" FontSize="10" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="Open" Command="{Binding OpenEfbInBrowserCommand}"
                                                   FontSize="10" Padding="8,4" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ====================================================================== -->
            <!-- TAB 2: RADAR & SYNOPTIC MAP                                            -->
            <!-- ====================================================================== -->
            <TabItem Header="🗺️ RADAR &amp; SYNOPTIC MAP">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Full Height Canvas Radar & Synoptic Map -->
                    <Border Grid.Column="0" Style="{StaticResource TacticalPanel}" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Tactical Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="SYNOPTIC WEATHER RADAR &amp; SURFACE ANALYSIS" Style="{StaticResource HeaderLabel}" Margin="0" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Radar.RadarTimestamp}" FontSize="10" Foreground="{StaticResource Accent.Brand}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ui:Button Content="Radar" FontSize="10" Padding="8,3" Command="{Binding Radar.ToggleLayerCommand}" CommandParameter="RADAR" Margin="0,0,3,0"/>
                                    <ui:Button Content="Isobars" FontSize="10" Padding="8,3" Command="{Binding Radar.ToggleLayerCommand}" CommandParameter="ISOBARS" Margin="0,0,3,0"/>
                                    <ui:Button Content="Barbs" FontSize="10" Padding="8,3" Command="{Binding Radar.ToggleLayerCommand}" CommandParameter="WINDS" Margin="0,0,3,0"/>
                                    <ui:Button Content="Airports" FontSize="10" Padding="8,3" Command="{Binding Radar.ToggleLayerCommand}" CommandParameter="STATIONS" Margin="0,0,10,0"/>
                                    <ui:Button Content="50 NM" FontSize="10" Padding="8,3" Command="{Binding Radar.SetRangeCommand}" CommandParameter="50" Margin="0,0,3,0"/>
                                    <ui:Button Content="100 NM" FontSize="10" Padding="8,3" Command="{Binding Radar.SetRangeCommand}" CommandParameter="100" Margin="0,0,3,0"/>
                                    <ui:Button Content="250 NM" FontSize="10" Padding="8,3" Command="{Binding Radar.SetRangeCommand}" CommandParameter="250"/>
                                </StackPanel>
                            </Grid>

                            <!-- Interactive Radar Canvas -->
                            <Border Grid.Row="1" Style="{StaticResource InsetWell}" Padding="2" ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <Canvas Width="768" Height="768" Background="{StaticResource Bg.Inset}">
                                        <!-- Radar Mosaic Tiles -->
                                        <ItemsControl ItemsSource="{Binding Radar.RadarTiles}" Visibility="{Binding Radar.ShowRadar, Converter={StaticResource BooleanToVisibility}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="768" Height="768"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding Image}" Width="256" Height="256" Stretch="Fill"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Synoptic Isobar Contours -->
                                        <ItemsControl ItemsSource="{Binding Radar.Isobars}" Visibility="{Binding Radar.ShowIsobars, Converter={StaticResource BooleanToVisibility}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="768" Height="768"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas Width="768" Height="768">
                                                        <Path Data="{Binding SvgPath}" Stroke="{Binding StrokeColor}" StrokeThickness="1.5"/>
                                                        <Border Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}" Background="#E6080C14" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="2" Padding="3,1">
                                                            <TextBlock Text="{Binding Label}" FontSize="8" Foreground="#99D8EE" FontWeight="Bold"/>
                                                        </Border>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Pressure Centers (High / Low) -->
                                        <ItemsControl ItemsSource="{Binding Radar.PressureCenters}" Visibility="{Binding Radar.ShowIsobars, Converter={StaticResource BooleanToVisibility}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="768" Height="768"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#E6080C14" BorderBrush="{Binding ColorHex}" BorderThickness="1.5" CornerRadius="12" Padding="6,2" Margin="-20,-12,0,0">
                                                        <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="Black" Foreground="{Binding ColorHex}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Meteorological Wind Barbs -->
                                        <ItemsControl ItemsSource="{Binding Radar.WindBarbs}" Visibility="{Binding Radar.ShowWindBarbs, Converter={StaticResource BooleanToVisibility}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="768" Height="768"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding SvgPath}" Stroke="#E0F2FE" StrokeThickness="1.5"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Crosshairs -->
                                        <Line X1="0" Y1="384" X2="768" Y2="384" Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="3,6"/>
                                        <Line X1="384" Y1="0" X2="384" Y2="768" Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="3,6"/>

                                        <!-- Range Rings -->
                                        <Ellipse Width="{Binding Radar.Ring25Diameter}" Height="{Binding Radar.Ring25Diameter}"
                                                 Canvas.Left="{Binding Radar.Ring25Left}" Canvas.Top="{Binding Radar.Ring25Left}"
                                                 Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="2,4"/>
                                        <Ellipse Width="{Binding Radar.Ring50Diameter}" Height="{Binding Radar.Ring50Diameter}"
                                                 Canvas.Left="{Binding Radar.Ring50Left}" Canvas.Top="{Binding Radar.Ring50Left}"
                                                 Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="2,4"/>
                                        <Ellipse Width="{Binding Radar.Ring100Diameter}" Height="{Binding Radar.Ring100Diameter}"
                                                 Canvas.Left="{Binding Radar.Ring100Left}" Canvas.Top="{Binding Radar.Ring100Left}"
                                                 Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="2,4"/>
                                        <Ellipse Width="{Binding Radar.Ring250Diameter}" Height="{Binding Radar.Ring250Diameter}"
                                                 Canvas.Left="{Binding Radar.Ring250Left}" Canvas.Top="{Binding Radar.Ring250Left}"
                                                 Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="2,4"/>

                                        <!-- Station Markers -->
                                        <ItemsControl ItemsSource="{Binding MapStations}" Visibility="{Binding Radar.ShowStations, Converter={StaticResource BooleanToVisibility}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="768" Height="768"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding SelectCommand}"
                                                            Background="Transparent" BorderThickness="0" Padding="0" Margin="-16,-16,0,0" Cursor="Hand">
                                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                            <Ellipse Width="6" Height="6" Fill="#38BDF8" HorizontalAlignment="Center"/>
                                                            <Border Background="#D0080C14" CornerRadius="2" Padding="2,1" Margin="0,1,0,0">
                                                                <TextBlock Text="{Binding IcaoId}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Center Aircraft Symbol -->
                                        <Polygon Points="384,374 392,392 384,386 376,392" Fill="{StaticResource Accent.Brand}" Stroke="#080C14" StrokeThickness="1"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right: Storms & Convective Cells Detail -->
                    <Border Grid.Column="1" Style="{StaticResource TacticalPanel}" Margin="6,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="CONVECTIVE CELLS &amp; STRIKES" Style="{StaticResource HeaderLabel}"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Strikes:" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.LightningCount}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Closest Strike:" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.ClosestStrike}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Storm Cells:" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.StormCellCount}" Foreground="#EF4444" FontWeight="Bold" FontSize="11"/>
                                </Grid>

                                <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,4,0,8"/>

                                <TextBlock Text="RECENT LIGHTNING DETECTIONS" Style="{StaticResource SubHeader}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LAT" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="1" Text="LON" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="2" Text="DIST" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="3" Text="TIME" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding WeatherDisplay.LightningStrikes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Latitude}" FontSize="9" Foreground="#F59E0B"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Longitude}" FontSize="9" Foreground="#F59E0B"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Distance}" FontSize="9" Foreground="#F59E0B"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Time}" FontSize="9" Foreground="#F59E0B"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ====================================================================== -->
            <!-- TAB 3: SIMBRIEF & DISPATCH                                             -->
            <!-- ====================================================================== -->
            <TabItem Header="✈️ SIMBRIEF &amp; DISPATCH">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: OFP Summary, Actions & FMC Winds -->
                    <Border Grid.Column="0" Style="{StaticResource TacticalPanel}" Margin="0,0,6,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="SIMBRIEF OFP &amp; DISPATCH" Style="{StaticResource HeaderLabel}"/>

                                <!-- Pilot ID Input & Fetch -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding FlightPlan.PilotId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Padding="8,5" Margin="0,0,6,0"/>
                                    <ui:Button Grid.Column="1" Content="Fetch OFP" Command="{Binding FlightPlan.FetchPlanCommand}"
                                               FontWeight="Bold" Padding="12,5"/>
                                </Grid>
                                <TextBlock Text="{Binding FlightPlan.StatusMessage}" FontSize="10" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                                <!-- Navigraph AIRAC & Actions Bar -->
                                <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,8"
                                        Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🌐 " FontSize="10"/>
                                            <TextBlock Text="{Binding FlightPlan.NavigraphAirac}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="📋 Copy Route" Command="{Binding FlightPlan.CopyRouteCommand}" FontSize="10" Padding="8,3" Margin="4,0,4,0"/>
                                        <ui:Button Grid.Column="2" Content="🗺 Charts" Command="{Binding FlightPlan.OpenNavigraphChartsCommand}" FontSize="10" Padding="8,3"/>
                                    </Grid>
                                </Border>

                                <!-- Prominent Dispatch Package Button (FR-F6) -->
                                <ui:Button Content="📄 VIEW DISPATCH BRIEFING PACKAGE (PDF / NAVLOG)" 
                                           Command="{Binding FlightPlan.OpenDispatchBriefingCommand}"
                                           Background="#1E293B" BorderBrush="{StaticResource Accent.Brand}" BorderThickness="1"
                                           Foreground="{StaticResource Accent.Brand}" FontWeight="Bold" FontSize="11" Padding="8,7" Margin="0,0,0,8"
                                           HorizontalAlignment="Stretch" Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}"/>

                                <!-- Flight Summary Card -->
                                <Border Style="{StaticResource InsetWell}" Padding="10,8" Margin="0,0,0,8"
                                        Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="FLT: " FontSize="10" Foreground="{StaticResource Text.Disabled}"/>
                                            <TextBlock Text="{Binding FlightPlan.FlightNumber}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="TYPE: " FontSize="10" Foreground="{StaticResource Text.Disabled}"/>
                                            <TextBlock Text="{Binding FlightPlan.AircraftType}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="ROUTE: " FontSize="10" Foreground="{StaticResource Text.Disabled}"/>
                                            <TextBlock Text="{Binding FlightPlan.Origin}" FontSize="13" FontWeight="Black" Foreground="{StaticResource Accent.Brand}"/>
                                            <TextBlock Text=" ➔ " FontSize="12" Foreground="{StaticResource Text.Disabled}"/>
                                            <TextBlock Text="{Binding FlightPlan.Destination}" FontSize="13" FontWeight="Black" Foreground="{StaticResource Accent.Brand}"/>
                                            <TextBlock Text=" (ALT: " FontSize="10" Foreground="{StaticResource Text.Disabled}" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding FlightPlan.Alternate}" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                                            <TextBlock Text=")" FontSize="10" Foreground="{StaticResource Text.Disabled}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="CRZ: " FontSize="10" Foreground="{StaticResource Text.Disabled}"/>
                                            <TextBlock Text="{Binding FlightPlan.CruiseAltitude}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="ETE: " FontSize="10" Foreground="{StaticResource Text.Disabled}"/>
                                            <TextBlock Text="{Binding FlightPlan.Ete}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Sky Anchor Corridor Status -->
                                <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                                        Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SKY ANCHOR CORRIDOR:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                            <TextBlock Text="{Binding FlightPlan.SkyAnchorPhaseText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding FlightPlan.SkyAnchorDistanceText}" FontSize="11" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- FMC Winds Export Buttons -->
                                <TextBlock Text="FMC WINDS ALOFT UPLINK" Style="{StaticResource HeaderLabel}" Margin="0,4,0,4"
                                           Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}"/>
                                <Grid Margin="0,0,0,4" Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" Content="PMDG .wx" Command="{Binding FlightPlan.ExportPmdgCommand}" FontSize="10" Padding="6,4" Margin="0,0,4,0"/>
                                    <ui:Button Grid.Column="1" Content="Fenix JSON" Command="{Binding FlightPlan.ExportFenixCommand}" FontSize="10" Padding="6,4" Margin="0,0,4,0"/>
                                    <ui:Button Grid.Column="2" Content="Export CSV" Command="{Binding FlightPlan.ExportCsvCommand}" FontSize="10" Padding="6,4"/>
                                </Grid>
                                <TextBlock Text="{Binding FlightPlan.ExportStatusMessage}" FontSize="9" Foreground="{StaticResource Accent.Brand}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"
                                           Visibility="{Binding FlightPlan.HasPlan, Converter={StaticResource BooleanToVisibility}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Corridor Navlog Waypoints Table -->
                    <Border Grid.Column="1" Style="{StaticResource TacticalPanel}" Margin="6,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="CORRIDOR WAYPOINTS &amp; UPPER AIR NAVIGATION LOG" Style="{StaticResource HeaderLabel}" Margin="0,0,0,8"/>

                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="WAYPOINT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                <TextBlock Grid.Column="1" Text="ALTITUDE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                <TextBlock Grid.Column="2" Text="WIND (DIR/SPD)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                                <TextBlock Grid.Column="3" Text="STATIC TEMP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}"/>
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FlightPlan.Waypoints}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="0,0,0,1" Padding="0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Identifier}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Altitude}" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Wind}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Temperature}" FontSize="11" Foreground="{StaticResource Text.Primary}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ====================================================================== -->
            <!-- TAB 4: VERTICAL SOUNDING (SKEW-T)                                      -->
            <!-- ====================================================================== -->
            <TabItem Header="📈 VERTICAL SOUNDING (SKEW-T)">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Large Graphical Sounding Profile -->
                    <Border Grid.Column="0" Style="{StaticResource TacticalPanel}" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ATMOSPHERIC SOUNDING &amp; LAPSE RATE PROFILE" Style="{StaticResource HeaderLabel}" Margin="0"/>
                                <ui:Button Grid.Column="1" Content="Graph / Table Mode" FontSize="10" Padding="8,3" Command="{Binding Sounding.ToggleModeCommand}"/>
                            </Grid>

                            <!-- Profile Canvas -->
                            <Border Grid.Row="1" Style="{StaticResource InsetWell}" Padding="4" ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <Canvas Width="360" Height="240" Background="{StaticResource Bg.Inset}">
                                        <!-- Flight Level Reference Grid Lines & Text -->
                                        <ItemsControl ItemsSource="{Binding Sounding.StandardLevels}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="360" Height="240"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas Width="360" Height="240">
                                                        <Line X1="0" Y1="{Binding Y}" X2="360" Y2="{Binding Y}" Stroke="#1E293B" StrokeThickness="1" StrokeDashArray="2,4"/>
                                                        <TextBlock Canvas.Left="4" Canvas.Top="{Binding Y}" Text="{Binding FlightLevelName}" FontSize="8" Foreground="#64748B" Margin="0,-6,0,0"/>
                                                        <TextBlock Canvas.Left="260" Canvas.Top="{Binding Y}" Text="{Binding WindText}" FontSize="8" Foreground="{StaticResource Accent.Brand}" Margin="0,-6,0,0"/>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Volumetric Cloud Blocks -->
                                        <ItemsControl ItemsSource="{Binding Sounding.CloudBlocks}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="360" Height="240"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas Width="360" Height="240">
                                                        <Border Canvas.Left="35" Canvas.Top="{Binding Y}" Width="220" Height="{Binding Height}"
                                                                Background="#38BDF8" Opacity="{Binding Opacity}" CornerRadius="3"
                                                                BorderBrush="#38BDF8" BorderThickness="1">
                                                            <TextBlock Text="{Binding Label}" FontSize="8" Foreground="#FFFFFF" Margin="4,1" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Atmospheric Hazard Bands (Icing / Turbulence) -->
                                        <ItemsControl ItemsSource="{Binding Sounding.HazardBands}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="360" Height="240"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas Width="360" Height="240">
                                                        <Border Canvas.Left="260" Canvas.Top="{Binding Y}" Width="95" Height="{Binding Height}"
                                                                Background="{Binding ColorHex}" Opacity="0.35" CornerRadius="2"
                                                                BorderBrush="{Binding ColorHex}" BorderThickness="1">
                                                            <TextBlock Text="{Binding Label}" FontSize="8" FontWeight="Bold" Foreground="{Binding ColorHex}" Margin="3,1" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 0°C Freezing Level Line & Badge -->
                                        <Line X1="0" Y1="{Binding Sounding.FreezingLevelY}" X2="360" Y2="{Binding Sounding.FreezingLevelY}" Stroke="#38BDF8" StrokeThickness="1.5" StrokeDashArray="3,3"/>
                                        <Border Canvas.Left="6" Canvas.Top="{Binding Sounding.FreezingLevelY}" Background="#E6080C14" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="2" Padding="3,1" Margin="0,-12,0,0">
                                            <TextBlock Text="{Binding Sounding.FreezingLevelLabel}" FontSize="7" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </Border>

                                        <!-- Aircraft Current Altitude Indicator -->
                                        <Canvas Visibility="{Binding Sounding.HasAircraftAltitude, Converter={StaticResource BooleanToVisibility}}">
                                            <Line X1="0" Y1="{Binding Sounding.AircraftLevelY}" X2="360" Y2="{Binding Sounding.AircraftLevelY}" Stroke="#F59E0B" StrokeThickness="1.5"/>
                                            <Polygon Points="350,0 358,6 350,12" Fill="#F59E0B" Canvas.Left="0" Canvas.Top="{Binding Sounding.AircraftLevelY}" Margin="0,-6,0,0"/>
                                        </Canvas>

                                        <!-- Temperature Lapse Rate Curve (Orange) -->
                                        <Path Data="{Binding Sounding.TemperatureSvg}" Stroke="#F97316" StrokeThickness="2"/>

                                        <!-- Dewpoint Curve (Cyan) -->
                                        <Path Data="{Binding Sounding.DewpointSvg}" Stroke="#38BDF8" StrokeThickness="2"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <!-- Profile Legend -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="━ Temperature (°C)" Foreground="#F97316" FontSize="9" FontWeight="Bold" Margin="0,0,12,0"/>
                                <TextBlock Text="━ Dewpoint" Foreground="#38BDF8" FontSize="9" FontWeight="Bold" Margin="0,0,12,0"/>
                                <TextBlock Text="┅ 0°C Freezing Level" Foreground="#38BDF8" FontSize="9" FontWeight="Bold" Margin="0,0,12,0"/>
                                <TextBlock Text="☁ Cloud Decks" Foreground="#94A3B8" FontSize="9" FontWeight="Bold" Margin="0,0,12,0"/>
                                <TextBlock Text="⚡ Hazard Bands" Foreground="#EF4444" FontSize="9" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: Icing & Turbulence Layers Tables -->
                    <Border Grid.Column="1" Style="{StaticResource TacticalPanel}" Margin="6,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Icing Layers -->
                                <TextBlock Text="ICING LAYERS &amp; SEVERITY" Style="{StaticResource HeaderLabel}"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="BASE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="1" Text="TOP" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="2" Text="SEV" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="3" Text="TYPE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding WeatherDisplay.IcingLayers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Base}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Top}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Severity}" FontSize="10" Foreground="{StaticResource Accent.Brand}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Type}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Background="{StaticResource Stroke.Subtle}" Margin="0,8,0,8"/>

                                <!-- Turbulence Layers -->
                                <TextBlock Text="TURBULENCE LAYERS &amp; EDDY DISSIPATION" Style="{StaticResource HeaderLabel}" Foreground="#F59E0B"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="BASE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="1" Text="TOP" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="2" Text="SEV" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                    <TextBlock Grid.Column="3" Text="TYPE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding WeatherDisplay.TurbulenceLayers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Base}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Top}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Severity}" FontSize="10" Foreground="#F59E0B"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Type}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ====================================================================== -->
            <!-- TAB 5: WEATHER STUDIO (SANDBOX)                                        -->
            <!-- ====================================================================== -->
            <TabItem Header="🛠️ WEATHER STUDIO">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status Banner & Extreme Presets -->
                    <Border Grid.Column="0" Style="{StaticResource TacticalPanel}" Margin="0,0,6,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Status Banner -->
                                <Border Background="#1A8B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="MANUAL SCENARIO STUDIO" FontSize="9" FontWeight="Bold" Foreground="#A78BFA"/>
                                            <TextBlock Text="{Binding SandboxStatusText}" FontSize="12" FontWeight="Black" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Content="Live Wx" Command="{Binding ExitSandboxModeCommand}" FontSize="10" Padding="8,4" Margin="0,0,4,0"/>
                                            <ui:Button Content="Apply" Command="{Binding ApplyCustomSandboxCommand}" FontSize="10" Padding="8,4" FontWeight="Bold" Background="#8B5CF6" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Extreme Approach Presets -->
                                <TextBlock Text="EXTREME APPROACH PRESETS (ONE-CLICK)" Style="{StaticResource HeaderLabel}"/>
                                <TextBlock Text="Instantly configure realistic meteorological edge cases for pilot training and flight testing:" FontSize="10" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 0 -->
                                    <ui:Button Grid.Row="0" Grid.Column="0" Command="{Binding ApplySandboxPresetCommand}" CommandParameter="fog" Margin="0,0,4,4" Padding="6,10" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🌁 CAT III Fog" FontSize="11" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="RVR 150m · 0ft Clg" FontSize="8" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Grid.Row="0" Grid.Column="1" Command="{Binding ApplySandboxPresetCommand}" CommandParameter="crosswind" Margin="2,0,2,4" Padding="6,10" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="💨 35G50 Cross" FontSize="11" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="090°/35kt · G50kt" FontSize="8" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Grid.Row="0" Grid.Column="2" Command="{Binding ApplySandboxPresetCommand}" CommandParameter="supercell" Margin="4,0,0,4" Padding="6,10" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="⚡ Supercell" FontSize="11" FontWeight="Black" Foreground="#EF4444" HorizontalAlignment="Center"/>
                                            <TextBlock Text="TSRA · CAPE 3800" FontSize="8" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>

                                    <!-- Row 1 -->
                                    <ui:Button Grid.Row="1" Grid.Column="0" Command="{Binding ApplySandboxPresetCommand}" CommandParameter="mountain_wave" Margin="0,0,4,0" Padding="6,10" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🏔️ Mtn Wave" FontSize="11" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Sev CAT · 135kt Jet" FontSize="8" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Grid.Row="1" Grid.Column="1" Command="{Binding ApplySandboxPresetCommand}" CommandParameter="severe_icing" Margin="2,0,2,0" Padding="6,10" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="❄️ Sev Icing" FontSize="11" FontWeight="Black" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                                            <TextBlock Text="-2°C FZRA · OVC" FontSize="8" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Grid.Row="1" Grid.Column="2" Command="{Binding ApplySandboxPresetCommand}" CommandParameter="clear_calm" Margin="4,0,0,0" Padding="6,10" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="☀️ CAVOK" FontSize="11" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Center"/>
                                            <TextBlock Text="4kt · 50km · SKC" FontSize="8" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>

                                <Border Style="{StaticResource InsetWell}" Padding="8,6">

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SkyWeave.App.ViewModels"
        xmlns:local="using:SkyWeave.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="SkyWeave.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SkyWeave - Real Weather Engine for MSFS 2024"
        Width="1400" Height="900"
        MinWidth="1200" MinHeight="700"
        Background="Transparent"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <local:BoolToBrushConverter x:Key="BoolToBrush"/>
        <local:FlightCategoryToBrushConverter x:Key="FlightCategoryToBrush"/>
        <local:FlightCategoryToChipBrushConverter x:Key="FlightCategoryToChipBrush"/>
        <local:IndexToProgressConverter x:Key="IndexToProgress"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Classes="glassHeader" Padding="15">
            <Grid>
                <Border IsHitTestVisible="False" CornerRadius="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Offset="0" Color="#33FF007F"/>
                            <GradientStop Offset="1" Color="#3300F0FF"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Padding="6,2" CornerRadius="6" BoxShadow="0 0 24 0 #66E94560">
                            <TextBlock Text="SkyWeave" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text=" Real Weather for MSFS 2024" FontSize="14" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Border Background="{StaticResource Accent.Brand}" CornerRadius="4" Padding="8,2" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionText}" FontSize="10" Foreground="{StaticResource Text.Primary}" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{Binding Connection.LastUpdate}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <Grid>
                            <Ellipse Width="12" Height="12" Fill="{Binding Connection.IsConnected, Converter={StaticResource BoolToBrush}}" Opacity="0.4"/>
                            <Ellipse Width="12" Height="12" Fill="{Binding Connection.IsConnected, Converter={StaticResource BoolToBrush}}" Opacity="0.8">
                                <Ellipse.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:1.5"/>
                                    </Transitions>
                                </Ellipse.Transitions>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="{Binding Connection.StatusText}" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Connect" Command="{Binding Connection.ConnectCommand}" Margin="0,0,5,0" IsEnabled="{Binding !Connection.IsConnected}"/>
                        <ToggleButton Content="Start"
                                      Command="{Binding Connection.StartWeatherCommand}"
                                      Margin="0,0,5,0"
                                      FontWeight="Bold"
                                      IsChecked="{Binding Connection.IsInjecting}"
                                      Background="{Binding Connection.IsInjecting, Converter={StaticResource BoolToBrush}}"
                                      Foreground="White"/>
                        <ToggleButton Content="Passive"
                                      Command="{Binding Connection.StartPassiveCommand}"
                                      Margin="0,0,5,0"
                                      IsChecked="{Binding Connection.IsPassiveMode}"
                                      Background="{Binding Connection.IsPassiveMode, Converter={StaticResource BoolToBrush}}"
                                      Foreground="White"/>
                        <Button Content="Refresh" Command="{Binding Connection.RefreshNowCommand}" Margin="0,0,5,0"/>
                        <Button Content="Stop" Command="{Binding Connection.StopWeatherCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Row 0, Col 0: Current Conditions -->
            <ContentControl Grid.Row="0" Grid.Column="0" Classes="tacticalPanel" Padding="12" Margin="0,0,5,5" Opacity="{Binding Settings.GlassOpacity}">
                <StackPanel>
                    <TextBlock Text="CURRENT CONDITIONS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Station:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.StationId}" FontWeight="Bold" FontSize="11" Foreground="#fff" Classes.skeleton="{Binding !Connection.IsConnected}"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Temperature:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Temperature}" FontWeight="Bold" FontSize="11" Foreground="#fff" Classes.skeleton="{Binding !Connection.IsConnected}"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dewpoint:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Dewpoint}" FontWeight="Bold" FontSize="11" Foreground="#00d2d3" Classes.skeleton="{Binding !Connection.IsConnected}"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Wind:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Wind}" FontWeight="Bold" FontSize="11" Foreground="#fff" Classes.skeleton="{Binding !Connection.IsConnected}"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Visibility:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Visibility}" FontWeight="Bold" FontSize="11" Foreground="#fff" Classes.skeleton="{Binding !Connection.IsConnected}"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Altimeter:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Altimeter}" FontWeight="Bold" FontSize="11" Foreground="#fff" Classes.skeleton="{Binding !Connection.IsConnected}"/>
                    </Grid>
                    <Grid Margin="0,0,0,5" IsVisible="{Binding Connection.HasSimWeatherReadback}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sim Readback:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding Connection.SimWeatherInfo}" FontWeight="Bold" FontSize="10" Foreground="#00d2d3"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Category:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <Border Grid.Column="1" Background="{Binding WeatherDisplay.FlightCategory, Converter={StaticResource FlightCategoryToBrush}}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding WeatherDisplay.FlightCategory}" FontWeight="Bold" FontSize="10" Foreground="White"/>
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Humidity:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Humidity}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Text.Primary}" Classes.skeleton="{Binding !Connection.IsConnected}"/>
                    </Grid>

                    <TextBlock Text="TAF BRIEF" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent.Brand}" Margin="0,10,0,6" LetterSpacing="0.5"/>
                    <Border Classes="insetWell" Padding="8,6" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Taf.TafText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap" MaxHeight="44"/>
                    </Border>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Forecast:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Border Classes="severityChip" Background="{Binding Taf.TafFlightCategory, Converter={StaticResource FlightCategoryToChipBrush}}">
                                <TextBlock Text="{Binding Taf.TafFlightCategory}" FontSize="10" FontWeight="Bold" Foreground="{Binding Taf.TafFlightCategory, Converter={StaticResource FlightCategoryToBrush}}"/>
                            </Border>
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Data.Caution}" VerticalAlignment="Center"
                                     IsVisible="{Binding Taf.TafDivergence}" ToolTip.Tip="METAR and TAF flight categories diverge"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Validity:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding Taf.TafValidity}" FontSize="11" Foreground="{StaticResource Text.Primary}"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Wind:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding Taf.TafWind}" FontSize="11" Foreground="{StaticResource Text.Primary}"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Visibility:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding Taf.TafVisibility}" FontSize="11" Foreground="{StaticResource Text.Primary}"/>
                    </Grid>
                    <TextBlock Text="FORECAST TREND" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,6,0,4"/>
                    <ItemsControl ItemsSource="{Binding Taf.TafGroups}" MaxHeight="52">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{Binding FlightCategory, Converter={StaticResource FlightCategoryToBrush}}"
                                        Background="{Binding FlightCategory, Converter={StaticResource FlightCategoryToBrush}}"
                                        Opacity="{Binding BlockOpacity}"
                                        Width="72" Height="40" Padding="4,2">
                                    <Grid>
                                        <Line StartPoint="0,0" EndPoint="72,0" Stroke="{StaticResource Data.Critical}"
                                              StrokeThickness="1" StrokeDashArray="4,3"
                                              IsVisible="{Binding IsTempo}" VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding FlightCategory, Converter={StaticResource FlightCategoryToBrush}}"/>
                                            <TextBlock Text="{Binding CloudSummary}" FontSize="8" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Wind}" FontSize="8" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <!-- Row 0, Col 1: Weather Indices with Progress Bars -->
            <ContentControl Grid.Row="0" Grid.Column="1" Classes="tacticalPanel" Padding="12" Margin="5,0,5,5" Opacity="{Binding Settings.GlassOpacity}">
                <StackPanel>
                    <TextBlock Text="WEATHER INDICES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" Margin="0,0,0,10"/>

                    <!-- Freezing Level -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Freezing Lvl:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.FreezingLevel}" FontWeight="Bold" FontSize="11" Foreground="#fff"/>
                    </Grid>

                    <!-- Ceiling -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ceiling:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Ceiling}" FontWeight="Bold" FontSize="11" Foreground="#fff"/>
                    </Grid>

                    <!-- Icing Index with progress bar -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Icing Index:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock Text="{Binding WeatherDisplay.IcingIndex}" FontWeight="Bold" FontSize="11" Foreground="#ff6b6b"/>
                            <Border Height="4" CornerRadius="2" Background="#1a1a2e" Margin="0,2,0,0">
                                <Border Background="#ff6b6b" Width="{Binding WeatherDisplay.IcingIndex, Converter={StaticResource IndexToProgress}, ConverterParameter='100'}"
                                        HorizontalAlignment="Left" CornerRadius="2"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Turbulence Index with progress bar -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Turbulence:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock Text="{Binding WeatherDisplay.TurbulenceIndex}" FontWeight="Bold" FontSize="11" Foreground="#ffa502"/>
                            <Border Height="4" CornerRadius="2" Background="#1a1a2e" Margin="0,2,0,0">
                                <Border Background="#ffa502" Width="{Binding WeatherDisplay.TurbulenceIndex, Converter={StaticResource IndexToProgress}, ConverterParameter='100'}"
                                        HorizontalAlignment="Left" CornerRadius="2"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Thunderstorm Intensity with progress bar -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Thunderstorm:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock Text="{Binding WeatherDisplay.ThunderstormIntensity}" FontWeight="Bold" FontSize="11" Foreground="#ff4757"/>
                            <Border Height="4" CornerRadius="2" Background="#1a1a2e" Margin="0,2,0,0">
                                <Border Background="#ff4757" Width="{Binding WeatherDisplay.ThunderstormIntensity, Converter={StaticResource IndexToProgress}, ConverterParameter='100'}"
                                        HorizontalAlignment="Left" CornerRadius="2"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Precipitation -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Precipitation:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.Precipitation}" FontWeight="Bold" FontSize="11" Foreground="#fff"/>
                    </Grid>

                    <!-- Aerosol Density -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Aerosol:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.AerosolDensity}" FontWeight="Bold" FontSize="11" Foreground="#fff"/>
                    </Grid>

                    <!-- Source Model -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Source Model:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.SourceModel}" FontWeight="Bold" FontSize="11" Foreground="#00d2d3"/>
                    </Grid>

                    <!-- Data Age -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Data Age:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.DataAge}" FontWeight="Bold" FontSize="11" Foreground="#fff"/>
                    </Grid>

                    <!-- CAPE -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CAPE:" Foreground="#666" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.CapeValue}" FontWeight="Bold" FontSize="11" Foreground="#ffd700"/>
                    </Grid>

                    <!-- Lifted Index -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Lifted Index:" Foreground="#666" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.LiftedIndexValue}" FontWeight="Bold" FontSize="11" Foreground="#ffa502"/>
                    </Grid>
                </StackPanel>
            </ContentControl>

            <!-- Row 0, Col 2: Lightning & Storms -->
            <ContentControl Grid.Row="0" Grid.Column="2" Classes="tacticalPanel" Padding="12" Margin="5,0,5,5" Opacity="{Binding Settings.GlassOpacity}">
                <StackPanel>
                    <TextBlock Text="LIGHTNING &amp; STORMS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Strikes:" Foreground="#666" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.LightningCount}" FontWeight="Bold" FontSize="11" Foreground="#ffd700"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Closest:" Foreground="#666" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.ClosestStrike}" FontWeight="Bold" FontSize="11" Foreground="#ffd700"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Storm Cells:" Foreground="#666" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.StormCellCount}" FontWeight="Bold" FontSize="11" Foreground="#ff4757"/>
                    </Grid>

                    <TextBlock Text="RECENT STRIKES" FontSize="10" FontWeight="Bold" Foreground="#888" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="LAT" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="1" Text="LON" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="2" Text="DIST" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="3" Text="TIME" FontSize="9" Foreground="#555"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding WeatherDisplay.LightningStrikes}" MaxHeight="120">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="55"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Latitude}" FontSize="9" Foreground="#ffd700"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Longitude}" FontSize="9" Foreground="#ffd700"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Distance}" FontSize="9" Foreground="#ffd700"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Time}" FontSize="9" Foreground="#ffd700"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <!-- Row 1, Col 0: Radar Overlay + Cloud Layers -->
            <ContentControl Grid.Row="1" Grid.Column="0" Classes="tacticalPanel" Padding="12" Margin="0,5,5,0" Opacity="{Binding Settings.GlassOpacity}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="RADAR" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent.Brand}" LetterSpacing="0.5"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Radar.RadarTimestamp}" FontSize="10" Foreground="{StaticResource Accent.Teal}" VerticalAlignment="Center"/>
                            <Button Content="25" FontSize="10" Padding="8,2" Command="{Binding Radar.SetRangeCommand}" CommandParameter="25"/>
                            <Button Content="50" FontSize="10" Padding="8,2" Command="{Binding Radar.SetRangeCommand}" CommandParameter="50"/>
                            <Button Content="100" FontSize="10" Padding="8,2" Command="{Binding Radar.SetRangeCommand}" CommandParameter="100"/>
                            <Button Content="250" FontSize="10" Padding="8,2" Command="{Binding Radar.SetRangeCommand}" CommandParameter="250"/>
                        </StackPanel>
                    </Grid>
                    <Border Classes="insetWell" Padding="4" Margin="0,0,0,6" ClipToBounds="True">
                        <Viewbox Stretch="Uniform" MaxHeight="225">
                            <Canvas Width="768" Height="768" Background="{StaticResource Bg.Inset}" Opacity="{Binding Radar.RadarFade}" IsVisible="{Binding Radar.RadarHasData}">
                                <Canvas.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                    </Transitions>
                                </Canvas.Transitions>
                                <ItemsControl ItemsSource="{Binding Radar.RadarTiles}" IsHitTestVisible="False">
                                    <ItemsControl.Styles>
                                        <Style Selector="ContentPresenter" x:DataType="vm:RadarTileViewModel">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.Styles>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="768" Height="768"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RadarTileViewModel">
                                            <Image Source="{Binding Image}" Width="256" Height="256" Stretch="Fill"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Crosshairs -->
                                <Line StartPoint="0,384" EndPoint="768,384" Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="3,6"/>
                                <Line StartPoint="384,0" EndPoint="384,768" Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="3,6"/>

                                <!-- Range Rings -->
                                <Ellipse Width="{Binding Radar.Ring25Diameter}" Height="{Binding Radar.Ring25Diameter}"
                                         Canvas.Left="{Binding Radar.Ring25Left}" Canvas.Top="{Binding Radar.Ring25Left}"
                                         Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="2,4"/>
                                <Ellipse Width="{Binding Radar.Ring50Diameter}" Height="{Binding Radar.Ring50Diameter}"
                                         Canvas.Left="{Binding Radar.Ring50Left}" Canvas.Top="{Binding Radar.Ring50Left}"
                                         Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="2,4"/>
                                <Ellipse Width="{Binding Radar.Ring100Diameter}" Height="{Binding Radar.Ring100Diameter}"
                                         Canvas.Left="{Binding Radar.Ring100Left}" Canvas.Top="{Binding Radar.Ring100Left}"
                                         Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="2,4"/>
                                <Ellipse Width="{Binding Radar.Ring250Diameter}" Height="{Binding Radar.Ring250Diameter}"
                                         Canvas.Left="{Binding Radar.Ring250Left}" Canvas.Top="{Binding Radar.Ring250Left}"
                                         Stroke="{StaticResource Stroke.Subtle}" StrokeThickness="1" StrokeDashArray="2,4"/>
                                         
                                <!-- Radar Sweep Animation -->
                                <Border Width="768" Height="768" Canvas.Left="0" Canvas.Top="0" Background="Transparent" IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Border.RenderTransform>
                                    <Border.Styles>
                                        <Style Selector="Border">
                                            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
                                            <Style.Animations>
                                                <Animation Duration="0:0:4" IterationCount="Infinite">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="RotateTransform.Angle" Value="0"/>
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="RotateTransform.Angle" Value="360"/>
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Border.Styles>
                                    <Line StartPoint="384,384" EndPoint="384,0" Stroke="{StaticResource Accent.Teal}" StrokeThickness="1.5" Opacity="0.75"/>
                                </Border>
                                <!-- Weather Stations Overlay -->
                                <ItemsControl ItemsSource="{Binding MapStations}">
                                    <ItemsControl.Styles>
                                        <Style Selector="ContentPresenter" x:DataType="vm:MapStationViewModel">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.Styles>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="768" Height="768"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MapStationViewModel">
                                            <Button Command="{Binding SelectCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="-18,-18,0,0"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="{Binding TooltipText}">
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                    <Grid Width="14" Height="14" HorizontalAlignment="Center">
                                                        <Ellipse Width="14" Height="14" Stroke="{StaticResource Accent.Brand}" StrokeThickness="1.5" IsVisible="{Binding IsSelected}"/>
                                                        <Ellipse Width="6" Height="6" Fill="{Binding CategoryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Border Background="#D00B0F19" CornerRadius="3" Padding="3,1" Margin="0,1,0,0" BorderBrush="{Binding BorderColor}" BorderThickness="1" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding IcaoId}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" FontFamily="Consolas"/>
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Center Aircraft Delta Marker -->
                                <Path Data="M 384,374 L 392,392 L 384,386 L 376,392 Z" Fill="{StaticResource Accent.Brand}" Stroke="{StaticResource Bg.Deep}" StrokeThickness="1" IsHitTestVisible="False"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="{Binding Radar.RangeText}" FontSize="10" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                    <TextBlock Text="CLOUD LAYERS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent.Brand}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="BASE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                        <TextBlock Grid.Column="1" Text="TOP" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                        <TextBlock Grid.Column="2" Text="TYPE" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                        <TextBlock Grid.Column="3" Text="DENS" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                        <TextBlock Grid.Column="4" Text="SCAT" FontSize="9" Foreground="{StaticResource Text.Disabled}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding WeatherDisplay.CloudLayers}" MaxHeight="110">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Base}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Top}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="10" Foreground="{StaticResource Accent.Teal}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Density}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Scattering}" FontSize="10" Foreground="{StaticResource Text.Primary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <!-- Row 1, Col 1: Icing & Turbulence -->
            <ContentControl Grid.Row="1" Grid.Column="1" Classes="tacticalPanel" Padding="12" Margin="5,5,5,0" Opacity="{Binding Settings.GlassOpacity}">
                <StackPanel>
                    <TextBlock Text="ICING LAYERS" FontSize="12" FontWeight="Bold" Foreground="#00d2d3" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="BASE" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="1" Text="TOP" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="2" Text="SEVERE" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="3" Text="TYPE" FontSize="9" Foreground="#555"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding WeatherDisplay.IcingLayers}" MaxHeight="80">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Base}" FontSize="10" Foreground="#fff"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Top}" FontSize="10" Foreground="#fff"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Severity}" FontSize="10" Foreground="#00d2d3"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Type}" FontSize="10" Foreground="#fff"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="TURBULENCE LAYERS" FontSize="12" FontWeight="Bold" Foreground="#ffa502" Margin="0,10,0,8"/>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="BASE" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="1" Text="TOP" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="2" Text="SEVERE" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="3" Text="TYPE" FontSize="9" Foreground="#555"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding WeatherDisplay.TurbulenceLayers}" MaxHeight="80">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Base}" FontSize="10" Foreground="#fff"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Top}" FontSize="10" Foreground="#fff"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Severity}" FontSize="10" Foreground="#ffa502"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Type}" FontSize="10" Foreground="#fff"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <!-- Row 1, Col 2: Winds Aloft + Hazards -->
            <ContentControl Grid.Row="1" Grid.Column="2" Classes="tacticalPanel" Padding="12" Margin="5,5,5,0" Opacity="{Binding Settings.GlassOpacity}">
                <StackPanel>
                    <TextBlock Text="WINDS ALOFT" FontSize="12" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ALT" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="1" Text="DIR" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="2" Text="SPD" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="3" Text="TEMP" FontSize="9" Foreground="#555"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding WeatherDisplay.WindLayers}" MaxHeight="140">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Altitude}" FontSize="10" Foreground="#fff"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Direction}" FontSize="10" Foreground="#fff"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Speed}" FontSize="10" Foreground="#fff"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Temperature}" FontSize="10" Foreground="#00d2d3"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="HAZARDS / SIGMETs" FontSize="12" FontWeight="Bold" Foreground="#ff4757" Margin="0,10,0,8"/>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TYPE" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="1" Text="SEV" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="2" Text="TO" FontSize="9" Foreground="#555"/>
                        <TextBlock Grid.Column="3" Text="DESC" FontSize="9" Foreground="#555"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding WeatherDisplay.Hazards}" MaxHeight="100">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Type}" FontSize="9" Foreground="#ff4757"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Severity}" FontSize="9" Foreground="#fff"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ValidTo}" FontSize="9" Foreground="#fff"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Description}" FontSize="9" TextTrimming="CharacterEllipsis" Foreground="#aaa"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <!-- Settings Column -->
            <ContentControl Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Classes="tacticalPanel" Padding="12" Margin="5,0,0,0" Opacity="{Binding Settings.GlassOpacity}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="STATION" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Connection.ManualStation, Mode=TwoWay}"
                                     PlaceholderText="ICAO (e.g. HECA)" FontSize="12" Margin="0,0,5,0"/>
                            <Button Grid.Column="1" Content="Go" Command="{Binding Connection.UseManualStationCommand}"
                                    Padding="10,4" FontWeight="Bold"/>
                        </Grid>
                        <TextBlock Text="{Binding Connection.SelectedAirportName}" FontSize="10" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="LOG" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Copy" FontSize="10" Padding="8,2" Margin="0,0,4,0" Command="{Binding CopyLogCommand}"/>
                            <Button Grid.Column="2" Content="Folder" FontSize="10" Padding="8,2" Command="{Binding OpenLogFolderCommand}"/>
                        </Grid>
                        <Border Classes="insetWell" Padding="6" Margin="0,0,0,10">
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding LogMessages}" FontFamily="Consolas" FontSize="9"
                                           Foreground="#00d2d3" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="CUSTOMIZE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent.Brand}" Margin="0,0,0,8"/>

                        <Expander IsExpanded="True" Margin="0,0,0,6">
                            <Expander.Header>
                                <TextBlock Text="ENGINE" FontSize="11" FontWeight="Bold" Foreground="#00d2d3"/>
                            </Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Refresh" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding Injection.RefreshIntervalSeconds, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Injection.RefreshIntervalSeconds, StringFormat={}{0:0}s}" Foreground="#00d2d3" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Smoothing" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Injection.SmoothingDurationMinutes, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Injection.SmoothingDurationMinutes, StringFormat={}{0:0} min}" Foreground="#00d2d3" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Injection" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Injection.InjectionIntervalSeconds, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Injection.InjectionIntervalSeconds, StringFormat={}{0:0}s}" Foreground="#00d2d3" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Auto-Connect" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.AutoConnect}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Passive" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Connection.IsPassiveMode}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander IsExpanded="False" Margin="0,0,0,6">
                            <Expander.Header>
                                <TextBlock Text="IMMERSION" FontSize="11" FontWeight="Bold" Foreground="#00d2d3"/>
                            </Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Wake Turbulence" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Injection.WakeTurbulenceEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Wake Strength" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                                            Value="{Binding Injection.WakeTurbulencePercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Injection.WakeTurbulencePercent, StringFormat={}{0:0}%}" Foreground="#00d2d3" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Turbulence" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                                            Value="{Binding Injection.TurbulenceIntensityPercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Injection.TurbulenceIntensityPercent, StringFormat={}{0:0}%}" Foreground="#00d2d3" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Gust Enhance" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                                            Value="{Binding Injection.GustEnhancementPercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Injection.GustEnhancementPercent, StringFormat={}{0:0}%}" Foreground="#00d2d3" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Thunderstorm" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                                            Value="{Binding Injection.ThunderstormIntensityPercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Injection.ThunderstormIntensityPercent, StringFormat={}{0:0}%}" Foreground="#00d2d3" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Precip" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                                            Value="{Binding Injection.PrecipitationPercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Injection.PrecipitationPercent, StringFormat={}{0:0}%}" Foreground="#00d2d3" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Aerosol" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                                            Value="{Binding Injection.AerosolPercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Injection.AerosolPercent, StringFormat={}{0:0}%}" Foreground="#00d2d3" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander IsExpanded="False" Margin="0,0,0,6">
                            <Expander.Header>
                                <TextBlock Text="VISUAL" FontSize="11" FontWeight="Bold" Foreground="#00d2d3"/>
                            </Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Glass Opacity" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.GlassOpacityPercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.GlassOpacityPercent, StringFormat={}{0:0}%}" Foreground="#00d2d3" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dark Theme" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.IsDarkTheme}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Classes="glassFooter" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Classes="severityChip" Background="{Binding Connection.ModeBadgeBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Connection.ModeBadgeText}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding WeatherDisplay.RawMetar}" Foreground="{StaticResource Text.Secondary}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Connection.AircraftPosition}" Foreground="{StaticResource Text.Secondary}" FontSize="10" Margin="10,0,0,0"/>
            </Grid>
        </Border>
        
    </Grid>
</Window>




